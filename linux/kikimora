#!/usr/bin/env bash
set -Eeuo pipefail

readonly VERSION="1.0.0"
readonly SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# CLI library location: development tree or installed system
if [[ -d "${SELF_DIR}/files/kikimora-cli" ]]; then
  readonly CLI_LIB_DIR="${SELF_DIR}/files/kikimora-cli"
else
  readonly CLI_LIB_DIR="/usr/local/libexec/kikimora/cli"
fi

source "${CLI_LIB_DIR}/common.sh"
source "${CLI_LIB_DIR}/help.sh"
source "${CLI_LIB_DIR}/dns.sh"
source "${CLI_LIB_DIR}/service.sh"
source "${CLI_LIB_DIR}/status.sh"
source "${CLI_LIB_DIR}/domains.sh"
source "${CLI_LIB_DIR}/config.sh"
source "${CLI_LIB_DIR}/maintenance.sh"

command="${1:-help}"
shift || true

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  command_help "$command"
  exit 0
fi

case "$command" in
  install) cmd_install "$@" ;;
  verify) cmd_verify "$@" ;;
  doctor) cmd_doctor "$@" ;;
  debuglog) cmd_debuglog "$@" ;;
  diag) cmd_diag "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  upgrade) cmd_upgrade "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  start|stop|restart|enable|disable) cmd_service "$command" "$@" ;;
  status) cmd_status "$@" ;;
  interfaces) cmd_interfaces "$@" ;;
  dns) cmd_dns "$@" ;;
  config) cmd_config "$@" ;;
  profiles) cmd_profiles "$@" ;;
  domains) cmd_domains "$@" ;;
  routes) cmd_routes "$@" ;;
  logs) cmd_logs "$@" ;;
  completion) cmd_completion "$@" ;;
  version|--version|-V) printf 'Kikimora %s\n' "$VERSION" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $command (see kikimora help)" ;;
esac
