#!/bin/bash
set -Eeu -o pipefail

readonly VERSION='1.0.0'
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ -r $SELF_DIR/lib.sh ]]; then BACKEND_DIR="$SELF_DIR"; else BACKEND_DIR='/usr/local/libexec/kikimora/macos'; fi
# shellcheck source=lib.sh
source "$BACKEND_DIR/lib.sh"
readonly PLIST_DIR='/Library/LaunchDaemons'
readonly MASTER_PLIST_DIR="$BACKEND_DIR"
readonly BACKUP_DIR='/var/backups/kikimora/leshy'
readonly PRIMARY_DOMAINS="${DOMAINS_DIR}/primary.txt"
readonly SECONDARY_DOMAINS="${DOMAINS_DIR}/secondary.txt"
readonly BYPASS_DOMAINS="${DOMAINS_DIR}/bypass.txt"
readonly PRIMARY_ROUTES="${ROUTES_DIR}/primary.txt"
readonly SECONDARY_ROUTES="${ROUTES_DIR}/secondary.txt"
readonly LABELS='com.kikimora.leshy com.kikimora.route-watch com.kikimora.health-watch'

usage() {
  cat <<'EOF'
Kikimora 1.0.0 for macOS — Leshy DNS and multi-VPN orchestration

Usage: kikimora COMMAND [OPTIONS]

Services:      start, stop, restart, enable [--now], disable [--now], status
Diagnostics:   interfaces, logs [-f|--no-follow] [-n N], verify, doctor
DNS:           dns {status|enable|disable|suspend|resume|check}
Configuration: config {show|edit|rebuild|validate}
Domains:       domains {list|add|remove|edit|import|export|default}
Static routes: routes {list|add|remove|edit|import|export}
Maintenance:   install, upgrade PATH, backup, restore [ARCHIVE], uninstall [--purge]
Other:         version, help
EOF
}

bootstrap() {
  local label="$1"
  launchctl_loaded "$label" || /bin/launchctl bootstrap system "$MASTER_PLIST_DIR/$label.plist"
}
bootout() { /bin/launchctl bootout "system/$1" >/dev/null 2>&1 || true; }
service_word() { if launchctl_loaded "$1"; then printf 'running'; else printf 'stopped'; fi; }

dns_ensure_enabled() {
  "$BACKEND_DIR/leshy-dns" resume >/dev/null 2>&1 || true
  if ! "$BACKEND_DIR/leshy-dns" check; then
    printf 'DNS integration is not active; enabling it.\n' >&2
    "$BACKEND_DIR/leshy-dns" enable
  fi
}

start_services() {
  require_root
  bootstrap com.kikimora.leshy
  bootstrap com.kikimora.route-watch
  bootstrap com.kikimora.health-watch
  /bin/launchctl kickstart -k system/com.kikimora.leshy
  /bin/launchctl kickstart -k system/com.kikimora.route-watch
  /bin/launchctl kickstart -k system/com.kikimora.health-watch
  for _ in {1..40}; do check_leshy_dns && break; sleep 0.25; done
  check_leshy_dns || die 'Leshy did not become ready; system DNS was not changed'
  dns_ensure_enabled
}

stop_services() {
  require_root
  "$BACKEND_DIR/leshy-dns" suspend || true
  bootout com.kikimora.health-watch
  bootout com.kikimora.route-watch
  bootout com.kikimora.leshy
  "$BACKEND_DIR/route-lifecycle" cleanup || true
}

rebuild_config() {
  local candidate
  candidate="$(mktemp "$CONFIG_DIR/.config.toml.new.XXXXXX")"
  if ! "$BACKEND_DIR/build-config" "$DOMAINS_DIR" "$candidate" "$ROUTING_CONFIG" "$ROUTES_DIR" ||
     ! "$BACKEND_DIR/check-config" "$LESHY_BIN" "$candidate"; then
    rm -f "$candidate"
    die 'configuration rebuild failed; running services were not changed'
  fi
  chmod 0644 "$candidate"
  mv -f "$candidate" "$LESHY_CONFIG"
  printf 'Configuration rebuilt and validated.\n'
}

cmd_service() {
  local action="$1" now=0 label
  shift || true
  case "$action" in
    start) [[ $# -eq 0 ]] || die 'usage: kk start'; start_services ;;
    stop) [[ $# -eq 0 ]] || die 'usage: kk stop'; stop_services ;;
    restart)
      [[ $# -eq 0 ]] || die 'usage: kk restart'
      require_root; rebuild_config; stop_services; start_services ;;
    enable|disable)
      [[ ${1:-} == --now ]] && { now=1; shift; }
      [[ $# -eq 0 ]] || die "usage: kk $action [--now]"
      require_root
      if [[ $action == disable && $now == 1 ]]; then stop_services; fi
      for label in $LABELS; do
        if [[ $action == enable ]]; then
          install -o root -g wheel -m 0644 "$MASTER_PLIST_DIR/$label.plist" "$PLIST_DIR/$label.plist"
          /bin/launchctl enable "system/$label"
        else
          rm -f "$PLIST_DIR/$label.plist"
          # Persistence is controlled by plist presence. Keep explicit bootstrap
          # available so `kk start` still works while autostart is disabled.
          /bin/launchctl enable "system/$label" >/dev/null 2>&1 || true
        fi
      done
      if [[ $action == enable && $now == 1 ]]; then start_services; fi
      ;;
  esac
}

count_file() { awk '!/^[[:space:]]*(#|$)/ { n++ } END { print n+0 }' "$1" 2>/dev/null || printf '0\n'; }
default_zone() {
  [[ -r $ROUTING_CONFIG ]] || { printf 'direct\n'; return; }
  /bin/bash -c 'source "$1"; printf "%s\n" "${DEFAULT_ZONE:-direct}"' _ "$ROUTING_CONFIG"
}

cmd_status() {
  load_config
  primary_resolved="$(resolve_role_interface primary || true)"
  secondary_resolved="$(resolve_role_interface secondary || true)"
  primary_display="${primary_resolved:-${PRIMARY_VPN_SERVICE:-$PRIMARY_INTERFACE}}"
  secondary_display="${secondary_resolved:-${SECONDARY_VPN_SERVICE:-$SECONDARY_INTERFACE}}"
  printf '== Services ==\n\nLeshy          %s\nRoute watcher  %s\nHealth watcher %s\n\n' \
    "$(service_word com.kikimora.leshy)" "$(service_word com.kikimora.route-watch)" "$(service_word com.kikimora.health-watch)"
  printf '== Interfaces ==\n\nRole       Interface  State\n'
  if [[ -n $primary_resolved ]] && interface_ready "$primary_resolved"; then pstate=ready; else pstate=down; fi
  if [[ -n $secondary_resolved ]] && interface_ready "$secondary_resolved"; then sstate=ready; else sstate=down; fi
  printf 'Primary    %-10s %s\nSecondary  %-10s %s\n\n' "$primary_display" "$pstate" "$secondary_display" "$sstate"
  printf '== Routing ==\n\nPrimary: %s domains, %s static routes\nSecondary: %s domains, %s static routes\nBypass: %s domains\nDefault: %s\n\n' \
    "$(count_file "$PRIMARY_DOMAINS")" "$(count_file "$PRIMARY_ROUTES")" \
    "$(count_file "$SECONDARY_DOMAINS")" "$(count_file "$SECONDARY_ROUTES")" \
    "$(count_file "$BYPASS_DOMAINS")" "$(default_zone)"
  "$BACKEND_DIR/leshy-dns" status
}

cmd_interfaces() {
  load_config
  for role in primary secondary; do
    iface="$(resolve_role_interface "$role" || true)"
    if [[ -z $iface ]]; then printf '== %s ==\ninterface unavailable\n\n' "$role"; continue; fi
    printf '== %s (%s) ==\n' "$role" "$iface"
    /sbin/ifconfig "$iface" 2>/dev/null || printf 'interface unavailable\n'
    /usr/sbin/netstat -rn -f inet | awk -v dev="$iface" 'NR <= 4 || $4 == dev'
    printf '\n'
  done
}

domain_file() {
  case "${1:-primary}" in primary|--primary) printf '%s\n' "$PRIMARY_DOMAINS";; secondary|--secondary) printf '%s\n' "$SECONDARY_DOMAINS";; bypass|--bypass) printf '%s\n' "$BYPASS_DOMAINS";; *) die 'zone must be primary, secondary, or bypass';; esac
}
route_file() {
  case "${1:-secondary}" in primary|--primary) printf '%s\n' "$PRIMARY_ROUTES";; secondary|--secondary) printf '%s\n' "$SECONDARY_ROUTES";; *) die 'zone must be primary or secondary';; esac
}
normalize_domain() {
  local value
  value="$(printf '%s' "${1%.}" | tr '[:upper:]' '[:lower:]')"
  [[ $value =~ ^(\*\.)?([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,63}$ ]] || die "invalid domain: $1"
  printf '%s\n' "$value"
}
normalize_route() {
  local value address prefix=''
  value="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  [[ -n $value && $value != *[[:space:]]* ]] || die "invalid route: $1"
  if [[ $value == */* ]]; then address="${value%%/*}"; prefix="${value#*/}"; else address="$value"; fi
  if [[ $address == *.* ]]; then
    printf '%s\n' "$address" | awk -F. 'NF==4 {for(i=1;i<=4;i++) if($i!~/^[0-9]+$/||$i>255) exit 1; exit 0} {exit 1}' || die "invalid IPv4 route: $1"
    [[ -z $prefix || $prefix =~ ^[0-9]+$ && $prefix -le 32 ]] || die "invalid IPv4 prefix: $1"
  elif [[ $address == *:* && $address =~ ^[0-9a-f:]+$ ]]; then
    [[ -z $prefix || $prefix =~ ^[0-9]+$ && $prefix -le 128 ]] || die "invalid IPv6 prefix: $1"
  else die "invalid IP/CIDR: $1"; fi
  printf '%s\n' "$value"
}

apply_list() {
  local target="$1" candidate="$2" backup config_candidate was_running=0
  require_root
  backup="$(mktemp /tmp/kikimora-list.old.XXXXXX)"
  config_candidate="$(mktemp "$CONFIG_DIR/.config.toml.list.XXXXXX")"
  cp "$target" "$backup"
  cp "$candidate" "$target"
  if ! "$BACKEND_DIR/build-config" "$DOMAINS_DIR" "$config_candidate" "$ROUTING_CONFIG" "$ROUTES_DIR" ||
     ! "$BACKEND_DIR/check-config" "$LESHY_BIN" "$config_candidate"; then
    cp "$backup" "$target"; rm -f "$backup" "$config_candidate"; die 'change rolled back: configuration validation failed'
  fi
  launchctl_loaded com.kikimora.leshy && was_running=1 || true
  chmod 0644 "$target" "$config_candidate"
  mv -f "$config_candidate" "$LESHY_CONFIG"
  rm -f "$backup"
  if ((was_running)); then stop_services; start_services; else printf 'Leshy is stopped; change applies on next start.\n'; fi
}

manage_list() {
  local kind="$1" sub="${2:-status}" target value zone tmp action
  shift 2 2>/dev/null || true
  case "$kind:$sub" in
    domains:status) printf 'Primary: %s\nSecondary: %s\nBypass: %s\n' "$(count_file "$PRIMARY_DOMAINS")" "$(count_file "$SECONDARY_DOMAINS")" "$(count_file "$BYPASS_DOMAINS")" ;;
    routes:status) printf 'Primary: %s\nSecondary: %s\n' "$(count_file "$PRIMARY_ROUTES")" "$(count_file "$SECONDARY_ROUTES")" ;;
    domains:list|routes:list)
      if (($#)); then
        [[ $kind == domains ]] && target="$(domain_file "$1")" || target="$(route_file "$1")"
        grep -Ev '^[[:space:]]*(#|$)' "$target" || true
      else
        zones='primary secondary'; [[ $kind == domains ]] && zones="$zones bypass"
        for zone in $zones; do printf '== %s ==\n' "$zone"; [[ $kind == domains ]] && target="$(domain_file "$zone")" || target="$(route_file "$zone")"; grep -Ev '^[[:space:]]*(#|$)' "$target" || true; done
      fi ;;
    domains:add|domains:remove|routes:add|routes:remove)
      (($# >= 1 && $# <= 2)) || die "usage: kk $kind $sub VALUE [ZONE]"
      [[ $kind == domains ]] && value="$(normalize_domain "$1")" || value="$(normalize_route "$1")"
      zone="${2:-}"; [[ $kind == domains ]] && target="$(domain_file "${zone:-primary}")" || target="$(route_file "${zone:-secondary}")"
      tmp="$(mktemp /tmp/kikimora-list.new.XXXXXX)"
      if [[ $sub == add ]]; then
        grep -Fqx "$value" "$target" && { rm -f "$tmp"; printf 'Already present: %s\n' "$value"; return; }
        { cat "$target"; printf '%s\n' "$value"; } | awk '!/^[[:space:]]*(#|$)/' | LC_ALL=C sort -u > "$tmp"
      else
        grep -Fqx "$value" "$target" || { rm -f "$tmp"; die "not found: $value"; }
        awk -v value="$value" '$0 != value' "$target" > "$tmp"
      fi
      apply_list "$target" "$tmp"; rm -f "$tmp"; printf '%s: %s\n' "$sub" "$value" ;;
    domains:edit|routes:edit)
      (($# == 1)) || die "usage: kk $kind edit ZONE"
      [[ $kind == domains ]] && target="$(domain_file "$1")" || target="$(route_file "$1")"
      tmp="$(mktemp /tmp/kikimora-list.edit.XXXXXX)"; cp "$target" "$tmp"; "${SUDO_EDITOR:-${EDITOR:-vi}}" "$tmp"; apply_list "$target" "$tmp"; rm -f "$tmp" ;;
    domains:import|routes:import)
      (($# == 2)) || die "usage: kk $kind import FILE ZONE"; [[ -r $1 ]] || die "cannot read: $1"
      [[ $kind == domains ]] && target="$(domain_file "$2")" || target="$(route_file "$2")"
      tmp="$(mktemp /tmp/kikimora-list.import.XXXXXX)"; cp "$1" "$tmp"; apply_list "$target" "$tmp"; rm -f "$tmp" ;;
    domains:export|routes:export)
      (($# == 1)) || die "usage: kk $kind export ZONE"; [[ $kind == domains ]] && target="$(domain_file "$1")" || target="$(route_file "$1")"; cat "$target" ;;
    domains:default)
      if (($# == 0)); then printf 'Default route for unmatched domains: %s\n' "$(default_zone)"; return; fi
      (($# == 1)) || die 'usage: kk domains default [direct|primary|secondary|none]'
      case "$1" in direct|primary|secondary|none) ;; *) die 'invalid default zone' ;; esac
      require_root; old="$(default_zone)"; [[ $old == "$1" ]] && { printf 'Unchanged: %s\n' "$old"; return; }
      routing_candidate="$(mktemp "$CONFIG_DIR/.routing.conf.new.XXXXXX")"
      config_candidate="$(mktemp "$CONFIG_DIR/.config.toml.default.XXXXXX")"
      awk -v mode="$1" 'BEGIN{done=0} /^DEFAULT_ZONE=/{print "DEFAULT_ZONE=" mode; done=1; next} {print} END{if(!done) print "DEFAULT_ZONE=" mode}' "$ROUTING_CONFIG" > "$routing_candidate"
      if ! "$BACKEND_DIR/build-config" "$DOMAINS_DIR" "$config_candidate" "$routing_candidate" "$ROUTES_DIR" ||
         ! "$BACKEND_DIR/check-config" "$LESHY_BIN" "$config_candidate"; then
        rm -f "$routing_candidate" "$config_candidate"; die 'default-zone change was not installed: validation failed'
      fi
      was_running=0; launchctl_loaded com.kikimora.leshy && was_running=1 || true
      chmod 0644 "$routing_candidate" "$config_candidate"
      mv -f "$routing_candidate" "$ROUTING_CONFIG"; mv -f "$config_candidate" "$LESHY_CONFIG"
      printf 'Default route changed: %s -> %s\n' "$old" "$1"
      if ((was_running)); then stop_services; start_services; fi ;;
    *) die "unknown $kind command: $sub" ;;
  esac
}

cmd_config() {
  sub="${1:-show}"
  case "$sub" in
    show) cat "$VPN_CONFIG"; printf '\n'; cat "$MACOS_CONFIG"; printf '\n'; cat "$ROUTING_CONFIG"; printf '\n'; cat "$LESHY_CONFIG" ;;
    edit) require_root; "${SUDO_EDITOR:-${EDITOR:-vi}}" "$VPN_CONFIG"; "$BACKEND_DIR/reconcile"; printf 'VPN configuration saved.\n' ;;
    rebuild) require_root; rebuild_config ;;
    validate) "$BACKEND_DIR/check-config" "$LESHY_BIN" "$LESHY_CONFIG" ;;
    *) die 'usage: kk config {show|edit|rebuild|validate}' ;;
  esac
}

cmd_logs() {
  lines=100; follow=1
  while (($#)); do case "$1" in -n|--lines) lines="$2"; shift 2;; --no-follow) follow=0; shift;; -f|--follow) follow=1; shift;; *) die "unknown logs option: $1";; esac; done
  files=(/var/log/kikimora/leshy.log /var/log/kikimora/route-watch.log /var/log/kikimora/health-watch.log)
  ((follow)) && exec tail -n "$lines" -F "${files[@]}" || exec tail -n "$lines" "${files[@]}"
}

cmd_verify() {
  require_root; failed=0
  for path in "$LESHY_BIN" "$LESHY_CONFIG" "$VPN_CONFIG" "$MACOS_CONFIG" "$BACKEND_DIR/reconcile" "$BACKEND_DIR/route-lifecycle" "$BACKEND_DIR/route-watch" "$BACKEND_DIR/health-watch" "$BACKEND_DIR/leshy-dns" "$BACKEND_DIR/leshy-service" "$MASTER_PLIST_DIR"/com.kikimora.*.plist; do
    if [[ -e $path ]]; then printf 'OK   %s\n' "$path"; else printf 'FAIL %s missing\n' "$path"; failed=1; fi
  done
  plutil -lint "$MASTER_PLIST_DIR"/com.kikimora.*.plist || failed=1
  "$BACKEND_DIR/check-config" "$LESHY_BIN" "$LESHY_CONFIG" || failed=1
  ((failed == 0)) || die 'verification completed with errors'
}

cmd_backup() { require_root; install -d -m 0700 "$BACKUP_DIR"; archive="$BACKUP_DIR/leshy-$(date '+%Y%m%d-%H%M%S').tar.gz"; tar -czf "$archive" "$CONFIG_DIR" "$MASTER_PLIST_DIR"/com.kikimora.*.plist; chmod 0600 "$archive"; printf 'Backup created: %s\n' "$archive"; }
cmd_restore() {
  require_root
  archive="${1:-}"
  if [[ -z $archive ]]; then
    archive=''
    for candidate in "$BACKUP_DIR"/leshy-*.tar.gz; do [[ -f $candidate ]] && archive="$candidate"; done
  fi
  [[ -f $archive ]] || die 'backup not found'
  stop_services
  tar -xzf "$archive" -C /
  printf 'Restored; services remain stopped.\n'
}

cmd_uninstall() {
  require_root; purge=0; [[ ${1:-} == --purge ]] && purge=1
  stop_services; "$BACKEND_DIR/leshy-dns" disable || true
  for label in $LABELS; do /bin/launchctl disable "system/$label" || true; done
  rm -f "$PLIST_DIR"/com.kikimora.*.plist /usr/local/bin/kk /usr/local/sbin/kikimora /usr/local/sbin/leshy-dns
  rm -rf /usr/local/libexec/kikimora/macos "$RUNTIME_ROOT"
  ((purge)) && rm -rf "$CONFIG_DIR" "$STATE_DIR" "$BACKUP_DIR"
  printf 'Kikimora removed; Leshy binary was not removed.\n'
}

require_macos
command="${1:-help}"; shift || true
case "$command" in
  start|stop|restart|enable|disable) cmd_service "$command" "$@" ;;
  status) cmd_status "$@" ;;
  interfaces) cmd_interfaces "$@" ;;
  dns) exec "$BACKEND_DIR/leshy-dns" "${1:-status}" ;;
  config) cmd_config "$@" ;;
  domains) manage_list domains "${1:-status}" "${@:2}" ;;
  routes) manage_list routes "${1:-status}" "${@:2}" ;;
  logs) cmd_logs "$@" ;;
  verify) cmd_verify ;;
  doctor) cmd_status; cmd_interfaces; cmd_verify; cmd_logs --no-follow -n 80 ;;
  backup) cmd_backup ;;
  restore) cmd_restore "$@" ;;
  install) exec "$BACKEND_DIR/install.sh" "$@" ;;
  upgrade) [[ -n ${1:-} && -x ${1%/}/install.sh ]] || die 'usage: kk upgrade RELEASE_DIRECTORY'; exec "${1%/}/install.sh" "${@:2}" ;;
  uninstall) cmd_uninstall "$@" ;;
  version|--version|-V) printf 'Kikimora %s\n' "$VERSION" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $command" ;;
esac
