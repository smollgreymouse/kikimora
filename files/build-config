#!/usr/bin/env bash
set -Eeuo pipefail
readonly DOMAINS_DIR="${1:-/etc/kikimora/leshy/domains}"
readonly OUTPUT_CONFIG="${2:-/etc/kikimora/leshy/config.toml}"
readonly ROUTING_CONFIG="${3:-$(dirname "$DOMAINS_DIR")/routing.conf}"
readonly PRIMARY_LIST="$DOMAINS_DIR/primary.txt"
readonly SECONDARY_LIST="$DOMAINS_DIR/secondary.txt"
readonly BYPASS_LIST="$DOMAINS_DIR/bypass.txt"
die(){ printf 'Ошибка: %s\n' "$*" >&2; exit 1; }
read_domains(){
  local file="$1" name="$2" line; local -a out=()
  [[ -r "$file" ]] || die "файл недоступен: $file"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"; line="${line%%#*}"; line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    [[ -n "$line" ]] || continue
    [[ "$line" =~ ^(\*\.)?([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]] || die "некорректный домен в $file: $line"
    out+=("${line,,}")
  done < "$file"
  if ((${#out[@]})); then mapfile -t out < <(printf '%s\n' "${out[@]}" | LC_ALL=C sort -u); fi
  local -n ref="$name"; ref=("${out[@]}")
}
write_domains(){ local file="$1" arr="$2"; local -n a="$arr"; local d; for d in "${a[@]}"; do printf '    "%s",\n' "$d" >>"$file"; done; }
write_zone(){
  local file="$1" name="$2" target="$3" arr="$4" mode="${5:-inclusive}"
  cat >>"$file" <<EOF

[[zones]]
name = "$name"
mode = "$mode"
dns_servers = []
route_type = "dev"
route_target = "$target"
domains = [
EOF
  write_domains "$file" "$arr"
  printf ']\npatterns = []\n' >>"$file"
}
[[ -d "$DOMAINS_DIR" ]] || die "каталог списков не найден: $DOMAINS_DIR"
[[ -r "$ROUTING_CONFIG" ]] || die "файл маршрутизации недоступен: $ROUTING_CONFIG"
DEFAULT_ZONE="$(bash -c 'set -Eeuo pipefail; source "$1"; printf "%s" "${DEFAULT_ZONE:-}"' _ "$ROUTING_CONFIG")"
case "$DEFAULT_ZONE" in direct|primary|secondary|none) ;; *) die "неизвестный DEFAULT_ZONE: ${DEFAULT_ZONE:-пусто}";; esac

declare -a primary_domains=() secondary_domains=() bypass_domains=()
read_domains "$PRIMARY_LIST" primary_domains; read_domains "$SECONDARY_LIST" secondary_domains; read_domains "$BYPASS_LIST" bypass_domains
# Explicit rules must be unambiguous.
declare -A owner=(); for z in primary secondary bypass; do declare -n a="${z}_domains"; for d in "${a[@]}"; do [[ -z "${owner[$d]:-}" ]] || die "домен $d одновременно указан в ${owner[$d]} и $z"; owner[$d]="$z"; done; done
outdir="$(dirname "$OUTPUT_CONFIG")"; install -d -m 0755 "$outdir"; tmp="$(mktemp "$outdir/.config.toml.tmp.XXXXXX")"; trap 'rm -f "$tmp"' EXIT
cat >"$tmp" <<'EOF'
# Generated by Kikimora. Edit domain lists and routing.conf instead.
[server]
listen_address = "127.0.0.1:53053"
default_upstream = ["1.1.1.1:53", "8.8.8.8:53"]
EOF
# Inclusive zones are written first, preserving explicit priority.
((${#primary_domains[@]})) && write_zone "$tmp" primary /run/kikimora/leshy/vpn/primary.dev primary_domains
((${#secondary_domains[@]})) && write_zone "$tmp" secondary /run/kikimora/leshy/vpn/secondary.dev secondary_domains
# Leshy exclusive mode routes every unmatched name through this zone; listed names are exclusions.
case "$DEFAULT_ZONE" in
  direct) ;;
  primary)
    declare -a primary_exclusions=("${bypass_domains[@]}" "${secondary_domains[@]}")
    write_zone "$tmp" default-primary /run/kikimora/leshy/vpn/primary.dev primary_exclusions exclusive ;;
  secondary)
    declare -a secondary_exclusions=("${bypass_domains[@]}" "${primary_domains[@]}")
    write_zone "$tmp" default-secondary /run/kikimora/leshy/vpn/secondary.dev secondary_exclusions exclusive ;;
  none)
    # Missing device + deny failure mode provides a DNS-level kill switch on Leshy 0.4.x.
    declare -a none_exclusions=("${bypass_domains[@]}" "${primary_domains[@]}" "${secondary_domains[@]}")
    write_zone "$tmp" default-deny /run/kikimora/leshy/vpn/deny-missing.dev none_exclusions exclusive
    printf 'route_failure_mode = "deny"\n' >>"$tmp" ;;
esac
chmod 0644 "$tmp"
if [[ -e "$OUTPUT_CONFIG" ]] && cmp -s "$tmp" "$OUTPUT_CONFIG"; then rm -f "$tmp"; trap - EXIT; printf 'Конфигурация не изменилась: %s\n' "$OUTPUT_CONFIG"; else mv -f "$tmp" "$OUTPUT_CONFIG"; trap - EXIT; printf 'Конфигурация создана: %s\n' "$OUTPUT_CONFIG"; fi
printf 'Default: %s; primary: %d; secondary: %d; bypass: %d\n' "$DEFAULT_ZONE" "${#primary_domains[@]}" "${#secondary_domains[@]}" "${#bypass_domains[@]}"
