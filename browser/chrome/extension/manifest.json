{
  "manifest_version": 3,
  "name": "Kikimora Domain Router",
  "version": "0.1.0",
  "description": "Добавляет домен текущей вкладки в primary или secondary конфигурацию Kikimora.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "Добавить домен в Kikimora",
    "default_popup": "popup.html"
  }
}
