#!/usr/bin/env bash
set -Eeuo pipefail
readonly LESHY_BIN="${1:-/usr/local/bin/leshy}"
readonly CONFIG="${2:-/etc/kikimora/leshy/config.toml}"
[[ -r "$CONFIG" ]] || { printf 'Error: configuration not found: %s\n' "$CONFIG" >&2; exit 1; }
[[ -x "$LESHY_BIN" ]] || { printf 'Error: Leshy binary not found: %s\n' "$LESHY_BIN" >&2; exit 1; }

if "$LESHY_BIN" --help 2>&1 | grep -q -- '--check-config'; then
    exec "$LESHY_BIN" --check-config "$CONFIG"
fi

tmp_dir="$(mktemp -d /tmp/kikimora-check.XXXXXX)"
tmp_config="$tmp_dir/config.toml"
log_file="$tmp_dir/leshy.log"
pid=''
cleanup() {
    local status=$?
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
    rm -rf -- "$tmp_dir"
    exit "$status"
}
trap cleanup EXIT

# Ask the kernel for a free loopback port without touching the production listener.
port="$(python3 - <<'PYPORT'
import socket
s=socket.socket(); s.bind(('127.0.0.1',0)); print(s.getsockname()[1]); s.close()
PYPORT
)"
awk -v listen="127.0.0.1:${port}" '
  /^[[:space:]]*listen_address[[:space:]]*=/ && !done { print "listen_address = \"" listen "\""; done=1; next }
  { print }
  END { if (!done) exit 42 }
' "$CONFIG" > "$tmp_config" || { printf 'Error: listen_address not found in configuration.\n' >&2; exit 1; }

printf 'Validating configuration on a temporary address 127.0.0.1:%s...\n' "$port"
"$LESHY_BIN" "$tmp_config" >"$log_file" 2>&1 & pid=$!
for _ in {1..40}; do
    if grep -q 'DNS server listening' "$log_file"; then
        kill -TERM "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; pid=''
        printf 'OK: configuration parsed; production port was not touched.\n'
        exit 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
        cat "$log_file" >&2
        printf 'Error: Leshy exited while validating configuration.\n' >&2
        exit 1
    fi
    sleep 0.1
done
cat "$log_file" >&2
printf 'Error: test DNS server did not start.\n' >&2
exit 1
