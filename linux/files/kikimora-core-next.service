[Unit]
Description=Kikimora VPN control plane (side-by-side staging)
After=network-pre.target
ConditionPathExists=/etc/kikimora-next/toads

[Service]
Type=simple
User=root
Group=kikimora
ExecStart=/opt/kikimora-next/bin/kikimora-core serve --socket /run/kikimora-next/core.sock --toad-binary /opt/kikimora-next/bin/kikimora-toad --config-dir /etc/kikimora-next/toads --ownership-config /etc/kikimora-next/orchestration-ownership.conf --leshy-publication-dir /run/kikimora-next/leshy/vpn --state-dir /var/lib/kikimora-next/core
# Same shutdown contract as kikimora-core.service: a restart marker keeps the
# fail-closed parks through a transient stop; remove it after the stop so a
# crashed restart cannot turn a later plain stop into a fail-closed one.
# Own restart-marker path: stopping the candidate must not clear the
# production core's fail-closed restart marker.
ExecStopPost=-/bin/rm -f /run/kikimora-next/core-restart.pending
Restart=on-failure
RestartSec=2s
RuntimeDirectory=kikimora-next
RuntimeDirectoryMode=0750
StateDirectory=kikimora-next/core
StateDirectoryMode=0750
UMask=0007
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
