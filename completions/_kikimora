#compdef kikimora kk

_kikimora() {
  local -a commands
  commands=(
    'install:Install or reinstall Leshy'
    'upgrade:Upgrade Kikimora from a local package'
    'uninstall:Remove Kikimora while keeping Leshy'
    'verify:Verify installation and configuration'
    'doctor:Run extended diagnostics'
    'backup:Create a backup'
    'restore:Restore from a backup'
    'start:Start Leshy'
    'stop:Stop Leshy'
    'restart:Restart Leshy'
    'status:Show Leshy and DNS state'
    'dns:Manage system DNS'
    'config:Manage configuration'
    'domains:Manage domain lists'
    'logs:Show logs'
    'completion:Generate completion script'
    'version:Show version'
    'help:Show help'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  case ${words[2]} in
    dns) _values 'dns command' enable disable suspend resume status help ;;
    domains) _values 'domains command' status list add remove edit import export default direct primary secondary none help ;;
    config) _values 'config command' show edit validate help ;;
    install)
      _arguments \
        '--primary-interface[Higher-priority VPN interface]:interface:' \
        '--secondary-interface[Lower-priority VPN interface]:interface:' \
        '--non-interactive[Do not ask interactive questions]' \
        '--stop-services[Allow stopping Leshy services]' \
        '(-y --yes)'{-y,--yes}'[Agree without prompting]' \
        '(-h --help)'{-h,--help}'[Show help]'
      ;;
    uninstall) _arguments '--purge[Remove configs and backups]' '(-y --yes)'{-y,--yes}'[Agree without prompting]' '(-h --help)'{-h,--help}'[Show help]' ;;
    logs) _arguments '(-f --follow)'{-f,--follow}'[Follow the log]' '(-h --help)'{-h,--help}'[Show help]' ;;
    upgrade|restore) _arguments '1:path:_files' '(-h --help)'{-h,--help}'[Show help]' ;;
    completion) _values 'shell' bash zsh fish ;;
    *) _arguments '(-h --help)'{-h,--help}'[Show help]' ;;
  esac
}

_kikimora "$@"
