{
  "manifest_version": 3,
  "name": "Kikimora Domain Router",
  "version": "0.2.0",
  "description": "Добавляет, показывает и удаляет домены в primary или secondary конфигурации Kikimora.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "Управление доменами Kikimora",
    "default_popup": "popup.html"
  }
}
