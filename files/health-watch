#!/usr/bin/env bash
set -Eeuo pipefail

readonly poll_seconds=2
readonly failure_limit=3
readonly repair_cooldown=5

readonly intent_file='/var/lib/kikimora/leshy/dns-enabled'
readonly dns_control='/usr/local/sbin/leshy-dns'

log() {
    printf 'leshy-health-watch: %s\n' "$*"
}

check_leshy_dns() {
    local output

    output=$(
        dig @127.0.0.1 -p 53053 . NS \
            +time=1 \
            +tries=1 \
            +noall \
            +comments 2>&1
    ) || return 1

    grep -Fq 'status: NOERROR' <<< "$output"
}

check_dns_integration() {
    "$dns_control" check
}

repair_dns_integration() {
    log 'Leshy отвечает, но системная DNS-интеграция потеряна; выполняю восстановление'

    if ! "$dns_control" resume; then
        log 'не удалось выполнить DNS resume'
        return 1
    fi

    if check_dns_integration; then
        log 'системная DNS-интеграция Leshy восстановлена'
        return 0
    fi

    log 'команда resume завершилась успешно, но DNS-интеграция всё ещё неполна'
    return 1
}

failures=0
reported_failure=0
reported_recovery=0
suspended_by_watch=0
last_repair_attempt=0
integration_failure_reported=0

while systemctl is-active --quiet leshy.service; do
    if [[ ! -e $intent_file ]]; then
        failures=0
        reported_failure=0
        reported_recovery=0
        suspended_by_watch=0
        integration_failure_reported=0

        sleep "$poll_seconds"
        continue
    fi

    if check_leshy_dns; then
        if ((reported_failure == 1 && reported_recovery == 0)); then
            if ((suspended_by_watch == 1)); then
                log 'Leshy снова отвечает; восстанавливаю системную DNS-интеграцию'
            else
                log 'Leshy снова отвечает до достижения порога аварийного отката'
            fi

            reported_recovery=1
        fi

        failures=0

        if check_dns_integration; then
            if ((integration_failure_reported == 1)); then
                log 'проверка подтверждает исправное состояние системной DNS-интеграции'
            fi

            integration_failure_reported=0
            suspended_by_watch=0
        else
            now=$(date +%s)

            if ((now - last_repair_attempt >= repair_cooldown)); then
                last_repair_attempt=$now

                if ((integration_failure_reported == 0)); then
                    integration_failure_reported=1
                fi

                if repair_dns_integration; then
                    integration_failure_reported=0
                    suspended_by_watch=0
                fi
            fi
        fi
    else
        ((failures += 1))
        reported_recovery=0

        if ((reported_failure == 0)); then
            log "Leshy не отвечает на DNS-запрос; начата проверка (${failures}/${failure_limit})"
            reported_failure=1
        fi

        if ((failures >= failure_limit)); then
            log "Leshy не ответил ${failure_limit} раза подряд; восстанавливаю исходный системный DNS"

            if "$dns_control" suspend; then
                suspended_by_watch=1
            else
                log 'не удалось полностью выполнить DNS suspend; смотри предыдущие сообщения'
            fi

            failures=0
            reported_failure=0
        fi
    fi

    sleep "$poll_seconds"
done