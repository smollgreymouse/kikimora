#!/usr/bin/env bash
set -Eeuo pipefail

readonly state_dir="${KIKIMORA_ROUTE_LIFECYCLE_STATE_DIR:-/run/kikimora/leshy/route-lifecycle}"
readonly vpn_runtime_dir="${KIKIMORA_VPN_RUNTIME_DIR:-/run/kikimora/leshy/vpn}"
readonly before_file="${state_dir}/before.routes"
readonly devices_file="${state_dir}/devices"
readonly owned_file="${state_dir}/owned.routes"
readonly parked_file="${state_dir}/parked.routes"
readonly restart_marker="${state_dir}/restart.pending"
readonly parking_metric="${KIKIMORA_ROUTE_PARKING_METRIC:-42760}"

log() {
    printf 'leshy-route-lifecycle: %s\n' "$*" >&2
}

read_devices() {
    local file value
    shopt -s nullglob

    for file in "${vpn_runtime_dir}"/*.dev; do
        while IFS= read -r value || [[ -n ${value} ]]; do
            value=${value%%#*}
            value=${value//$'\r'/}
            value=${value#"${value%%[![:space:]]*}"}
            value=${value%"${value##*[![:space:]]}"}
            [[ -n ${value} ]] || continue
            printf '%s\n' "${value}"
        done < "${file}"
    done | LC_ALL=C sort -u
}

valid_device_name() {
    local dev="$1"
    [[ -n ${dev} ]] || return 1
    [[ ${dev} != *[[:space:]/]* ]] || return 1
}

validate_device() {
    local dev="$1"
    valid_device_name "${dev}" || return 1
    grep -Fqx -- "${dev}" "${devices_file}" 2>/dev/null
}

ensure_state_files() {
    install -d -m 0755 "${state_dir}"
    touch "${devices_file}" "${before_file}" "${owned_file}" "${parked_file}"
}

list_host_routes_for_device() {
    local dev="$1"
    local route prefix

    ip link show dev "${dev}" >/dev/null 2>&1 || return 0

    while IFS= read -r route; do
        [[ -n ${route} ]] || continue
        case " ${route} " in
            *' proto static '*) ;;
            *) continue ;;
        esac

        prefix=${route%% *}
        [[ ${prefix} == */* ]] || prefix="${prefix}/32"
        [[ ${prefix} == */32 ]] || continue
        printf '%s\t%s\n' "${dev}" "${prefix}"
    done < <(ip -o -4 route show dev "${dev}" 2>/dev/null || true)
}

list_host_routes() {
    local dev
    [[ -f ${devices_file} ]] || return 0

    while IFS= read -r dev; do
        [[ -n ${dev} ]] || continue
        list_host_routes_for_device "${dev}"
    done < "${devices_file}"
}

list_owned_routes_for_device() {
    local dev="$1" route_dev prefix

    list_host_routes_for_device "${dev}" |
        while IFS=$'\t' read -r route_dev prefix; do
            [[ -n ${route_dev} && -n ${prefix} ]] || continue
            if ! grep -Fqx -- "${route_dev}"$'\t'"${prefix}" "${before_file}" 2>/dev/null; then
                printf '%s\t%s\n' "${route_dev}" "${prefix}"
            fi
        done
}

replace_device_state() {
    local file="$1" dev="$2" source_file="$3"
    local tmp="${file}.tmp.$$"

    grep -Fv -- "${dev}"$'\t' "${file}" > "${tmp}" 2>/dev/null || true
    cat "${source_file}" >> "${tmp}"
    LC_ALL=C sort -u -o "${tmp}" "${tmp}"
    mv -f -- "${tmp}" "${file}"
}

remove_parked_record() {
    local dev="$1" prefix="$2"
    local tmp="${parked_file}.tmp.$$"

    grep -Fvx -- "${dev}"$'\t'"${prefix}" "${parked_file}" > "${tmp}" 2>/dev/null || true
    mv -f -- "${tmp}" "${parked_file}"
}

release_restored_parks() {
    local current_file="$1" dev prefix

    while IFS=$'\t' read -r dev prefix; do
        [[ -n ${dev} && -n ${prefix} ]] || continue
        grep -Fqx -- "${dev}"$'\t'"${prefix}" "${parked_file}" 2>/dev/null || continue

        # The real Leshy route is present again. Only now remove the high-metric
        # unreachable fallback, so there is never a direct/default-route window
        # between VPN recovery and route rematerialization.
        ip -4 route del unreachable "${prefix}" proto static metric "${parking_metric}" >/dev/null 2>&1 || true
        remove_parked_record "${dev}" "${prefix}"
        log "released parked route ${prefix} after ${dev} restored it"
    done < "${current_file}"
}

observe_device() {
    local dev="${1:-}"
    local current

    validate_device "${dev}" || {
        log "device not in Leshy snapshot: ${dev:-<empty>}"
        return 0
    }

    # If the interface has already disappeared, keep the last observation. The
    # kernel removes device routes together with the interface, and that cached
    # set is exactly what cleanup-device needs in order to fail closed.
    ip link show dev "${dev}" >/dev/null 2>&1 || return 0

    current="${owned_file}.current.$$"
    list_owned_routes_for_device "${dev}" | LC_ALL=C sort -u > "${current}"
    release_restored_parks "${current}"
    replace_device_state "${owned_file}" "${dev}" "${current}"
    rm -f -- "${current}"
}

remove_new_routes_from_stream() {
    local dev prefix
    [[ -f ${before_file} ]] || : > "${before_file}"

    while IFS=$'\t' read -r dev prefix; do
        [[ -n ${dev} && -n ${prefix} ]] || continue
        if ! grep -Fqx -- "${dev}"$'\t'"${prefix}" "${before_file}"; then
            log "removing Leshy-created route ${prefix} dev ${dev}"
            ip -4 route del "${prefix}" dev "${dev}" proto static 2>/dev/null \
                || ip -4 route del "${prefix}" dev "${dev}" 2>/dev/null \
                || log "route already missing or could not remove: ${prefix} dev ${dev}"
        fi
    done
}

record_parked_route() {
    local dev="$1" prefix="$2"
    grep -Fqx -- "${dev}"$'\t'"${prefix}" "${parked_file}" 2>/dev/null || \
        printf '%s\t%s\n' "${dev}" "${prefix}" >> "${parked_file}"
    LC_ALL=C sort -u -o "${parked_file}" "${parked_file}"
}

park_route() {
    local dev="$1" prefix="$2"

    # Remove the live device route if it still exists, then retain only the
    # destination knowledge as a host-specific fail-closed route. A /32
    # unreachable route wins over every ordinary default route regardless of
    # its deliberately high metric. When the VPN returns, Leshy can install a
    # lower-metric real /32 alongside it; observe-device then removes the park.
    ip -4 route del "${prefix}" dev "${dev}" proto static >/dev/null 2>&1 \
        || ip -4 route del "${prefix}" dev "${dev}" >/dev/null 2>&1 \
        || true

    if ip -4 route replace unreachable "${prefix}" proto static metric "${parking_metric}"; then
        record_parked_route "${dev}" "${prefix}"
        log "parked Leshy route ${prefix} from ${dev} as unreachable"
    else
        log "failed to park Leshy route ${prefix} from ${dev}"
        return 1
    fi
}

unpark_all() {
    local dev prefix
    [[ -f ${parked_file} ]] || return 0

    while IFS=$'\t' read -r dev prefix; do
        [[ -n ${dev} && -n ${prefix} ]] || continue
        ip -4 route del unreachable "${prefix}" proto static metric "${parking_metric}" >/dev/null 2>&1 || true
    done < "${parked_file}"

    : > "${parked_file}"
}

snapshot() {
    install -d -m 0755 "${state_dir}"
    read_devices > "${devices_file}.tmp"
    mv -f -- "${devices_file}.tmp" "${devices_file}"
    list_host_routes | LC_ALL=C sort -u > "${before_file}.tmp"
    mv -f -- "${before_file}.tmp" "${before_file}"
    : > "${owned_file}"
    [[ -f ${parked_file} ]] || : > "${parked_file}"

    # A successful service start has crossed the internal-restart boundary.
    # Keep the parks themselves until real routes are observed again, but the
    # next ordinary stop must once again perform full cleanup.
    rm -f -- "${restart_marker}"

    log "snapshot created: $(wc -l < "${before_file}") existing /32-routes; devices: $(wc -l < "${devices_file}")."
}

begin_device() {
    local dev="${1:-}"
    local tmp empty

    valid_device_name "${dev}" || {
        log "invalid device name: ${dev:-<empty>}"
        return 64
    }

    ensure_state_files

    if ! grep -Fqx -- "${dev}" "${devices_file}"; then
        printf '%s\n' "${dev}" >> "${devices_file}"
        LC_ALL=C sort -u -o "${devices_file}" "${devices_file}"
    fi

    tmp="${before_file}.tmp.$$"
    grep -Fv -- "${dev}"$'\t' "${before_file}" > "${tmp}" || true
    list_host_routes_for_device "${dev}" >> "${tmp}"
    LC_ALL=C sort -u -o "${tmp}" "${tmp}"
    mv -f -- "${tmp}" "${before_file}"

    empty="${owned_file}.empty.$$"
    : > "${empty}"
    replace_device_state "${owned_file}" "${dev}" "${empty}"
    rm -f -- "${empty}"

    log "base snapshot updated for device: ${dev}"
}

cleanup_device() {
    local dev="${1:-}"
    local route_dev prefix

    [[ -f ${devices_file} ]] || {
        log 'no device snapshot; device cleanup skipped.'
        return 0
    }

    validate_device "${dev}" || {
        log "device not in Leshy snapshot: ${dev:-<empty>}"
        return 0
    }

    # Capture one final state when possible. If the device is already gone,
    # observe_device intentionally preserves the previous observation.
    observe_device "${dev}"

    while IFS=$'\t' read -r route_dev prefix; do
        [[ ${route_dev} == "${dev}" && -n ${prefix} ]] || continue
        park_route "${dev}" "${prefix}" || true
    done < "${owned_file}"
}

prepare_restart() {
    ensure_state_files
    : > "${restart_marker}"
    log 'internal restart prepared; parked routes will be preserved'
}

clear_parking() {
    ensure_state_files
    unpark_all
    rm -f -- "${restart_marker}"
    log 'all parked routes cleared'
}

cleanup_all() {
    [[ -f ${devices_file} ]] || {
        log 'no device snapshot; cleanup skipped.'
        return 0
    }

    list_host_routes | LC_ALL=C sort -u | remove_new_routes_from_stream

    if [[ -e ${restart_marker} ]]; then
        # route-watch or `kk restart` intentionally restarted Leshy to rebuild
        # its route state. Keep fail-closed parks across that service stop; the
        # next snapshot rebuilds baseline/ownership and clears the marker.
        : > "${devices_file}"
        : > "${before_file}"
        : > "${owned_file}"
        log 'service cleanup preserved parked routes for internal restart'
        return 0
    fi

    unpark_all
    rm -rf -- "${state_dir}"
}

validate_settings() {
    [[ ${parking_metric} =~ ^[1-9][0-9]*$ ]] || {
        log "invalid parking metric: ${parking_metric}"
        exit 64
    }
}

validate_settings

case "${1:-}" in
    snapshot)
        snapshot
        ;;
    begin-device)
        begin_device "${2:-}"
        ;;
    observe-device)
        observe_device "${2:-}"
        ;;
    cleanup-device)
        cleanup_device "${2:-}"
        ;;
    prepare-restart)
        prepare_restart
        ;;
    clear-parking)
        clear_parking
        ;;
    cleanup)
        cleanup_all
        ;;
    *)
        log 'Usage: route-lifecycle snapshot|begin-device DEVICE|observe-device DEVICE|cleanup-device DEVICE|prepare-restart|clear-parking|cleanup'
        exit 64
        ;;
esac
