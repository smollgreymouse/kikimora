#!/usr/bin/env bash
set -Eeuo pipefail

readonly poll_seconds=2
readonly failure_limit=3
readonly repair_cooldown=5
readonly query_timeout=12

readonly intent_file='/var/lib/kikimora/leshy/dns-enabled'
readonly dns_control='/usr/local/sbin/leshy-dns'

log() {
    printf 'leshy-health-watch: %s\n' "$*"
}

check_leshy_dns() {
    local output

    output=$(
        dig @127.0.0.1 -p 53053 . NS \
            +time="$query_timeout" \
            +tries=1 \
            +noall \
            +comments 2>&1
    ) || return 1

    grep -Fq 'status: NOERROR' <<< "$output"
}

check_dns_integration() {
    "$dns_control" check
}

repair_dns_integration() {
    log 'Leshy responds but system DNS integration lost; performing recovery'

    if ! "$dns_control" resume; then
        log 'failed to execute DNS resume'
        return 1
    fi

    if check_dns_integration; then
        log 'Leshy system DNS integration restored'
        return 0
    fi

    log 'resume command succeeded but DNS integration still incomplete'
    return 1
}

failures=0
reported_failure=0
reported_recovery=0
suspended_by_watch=0
last_repair_attempt=0
integration_failure_reported=0

while systemctl is-active --quiet leshy.service; do
    if [[ ! -e $intent_file ]]; then
        failures=0
        reported_failure=0
        reported_recovery=0
        suspended_by_watch=0
        integration_failure_reported=0

        sleep "$poll_seconds"
        continue
    fi

    if check_leshy_dns; then
        if ((reported_failure == 1 && reported_recovery == 0)); then
            if ((suspended_by_watch == 1)); then
                log 'Leshy is responding again; restoring system DNS integration'
            else
                log 'Leshy is responding again before emergency fallback threshold'
            fi

            reported_recovery=1
        fi

        failures=0

        if check_dns_integration; then
            if ((integration_failure_reported == 1)); then
                log 'check confirms system DNS integration is healthy'
            fi

            integration_failure_reported=0
            suspended_by_watch=0
        else
            now=$(date +%s)

            if ((now - last_repair_attempt >= repair_cooldown)); then
                last_repair_attempt=$now

                if ((integration_failure_reported == 0)); then
                    integration_failure_reported=1
                fi

                if repair_dns_integration; then
                    integration_failure_reported=0
                    suspended_by_watch=0
                fi
            fi
        fi
    else
        ((failures += 1))
        reported_recovery=0

        if ((reported_failure == 0)); then
            log "Leshy DNS query failed; check started (${failures}/${failure_limit})"
            reported_failure=1
        fi

        if ((failures >= failure_limit)); then
            log "Leshy DNS query failed ${failure_limit} times in a row; restoring original system DNS"

            if "$dns_control" suspend; then
                suspended_by_watch=1
            else
                log 'failed to complete DNS suspend; see previous messages'
            fi

            failures=0
            reported_failure=0
        fi
    fi

    sleep "$poll_seconds"
done