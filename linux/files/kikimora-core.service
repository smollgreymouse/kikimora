[Unit]
Description=Kikimora VPN control plane
Before=leshy.service
Wants=leshy.service kikimora-leshy-dns.service
After=network-pre.target

[Service]
Type=simple
User=root
Group=kikimora
ExecStart=/usr/local/bin/kikimora-core serve --config-dir /etc/kikimora/toads --ownership-config /etc/kikimora/leshy/orchestration-ownership.conf --endpoint-provider-dir /usr/local/libexec/kikimora/endpoint-providers --leshy-publication-dir /run/kikimora/leshy/vpn --state-dir /var/lib/kikimora/core
# The restart orchestration touches /run/kikimora/core-restart.pending before
# "systemctl restart": while it exists at SIGTERM the daemon keeps the
# fail-closed parks (transient restart), an ordinary stop releases the network.
# Remove it here so a crashed restart cannot turn a later plain stop into a
# fail-closed one.
ExecStopPost=-/bin/rm -f /run/kikimora/core-restart.pending
Restart=on-failure
RestartSec=2s
RuntimeDirectory=kikimora
RuntimeDirectoryMode=0750
StateDirectory=kikimora/core
StateDirectoryMode=0750
UMask=0007
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
