<?xml version="1.0" encoding="UTF-8"?>
<!--
SPDX-License-Identifier: MIT

Kikimora Windows Installer (MSI). Built with WiX v3:
  candle -arch x64 -dVersion=1.0.0 kikimora.wxs
  light -ext WixUtilExtension -out kikimora-<version>-windows-amd64.msi kikimora.wixobj

The MSI is the primary Windows installation contract: it installs the core
and toad binaries, creates the crash-safe ProgramData layout, registers the
KikimoraCore service (automatic start) and removes the service on uninstall.
Desired state under ProgramData survives upgrade and uninstall; a purge is a
manual, explicit step.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?define UpgradeCode = "6A845F57-1E45-4E46-9573-D55EB20B116D" ?>
  <?define ServiceName = "KikimoraCore" ?>

  <Product Id="*"
           Name="Kikimora"
           Language="1049"
           Codepage="1251"
           Version="$(var.Version)"
           Manufacturer="Kikimora"
           UpgradeCode="$(var.UpgradeCode)">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="Kikimora VPN control plane and per-role transports"
             Manufacturer="Kikimora"
             SummaryCodepage="1251" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOREPAIR" Value="1" />

<?ifdef UiPresented ?>
    <!-- Finish-dialog checkbox: start the tray UI right after installation and
         register it for the next logon in one go. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Запустить Kikimora сейчас" />
    <!-- Hardening follows the independent audit: replace the inherited
         ProgramData DACL on the credential-bearing directories (state, toads,
         logs, leshy). Deferred, as SYSTEM; failure is fatal - a
         world-readable key directory must not install. Raw SIDs, not names:
         on localized Windows "Administrators" does not resolve
         (ru-RU: "No mapping between account names and security IDs").
         One action per directory: icacls rejects a quoted multi-path line. -->
    <CustomAction Id="HardenStateDir" Directory="DATAROOT" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="icacls.exe &quot;[DATAROOT]state&quot; /inheritance:r /grant &quot;*S-1-5-18:(OI)(CI)F&quot; /grant &quot;*S-1-5-32-544:(OI)(CI)F&quot;" />
    <CustomAction Id="HardenToadsDir" Directory="DATAROOT" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="icacls.exe &quot;[DATAROOT]toads&quot; /inheritance:r /grant &quot;*S-1-5-18:(OI)(CI)F&quot; /grant &quot;*S-1-5-32-544:(OI)(CI)F&quot;" />
    <CustomAction Id="HardenLogsDir" Directory="DATAROOT" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="icacls.exe &quot;[DATAROOT]logs&quot; /inheritance:r /grant &quot;*S-1-5-18:(OI)(CI)F&quot; /grant &quot;*S-1-5-32-544:(OI)(CI)F&quot;" />
    <CustomAction Id="HardenLeshyDir" Directory="DATAROOT" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="icacls.exe &quot;[DATAROOT]leshy&quot; /inheritance:r /grant &quot;*S-1-5-18:(OI)(CI)F&quot; /grant &quot;*S-1-5-32-544:(OI)(CI)F&quot;" />
    <InstallExecuteSequence>
      <Custom Action="HardenStateDir" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="HardenToadsDir" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="HardenLogsDir" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="HardenLeshyDir" After="InstallFiles">NOT Installed</Custom>
    </InstallExecuteSequence>

    <CustomAction Id="StartKikimora" FileKey="KikimoraUiExe"
                  ExeCommand="--background"
                  Execute="immediate" Return="asyncNoWait" Impersonate="yes" />
<?endif ?>

    <UI>
      <UIRef Id="WixUI_FeatureTree" />
<?ifdef UiPresented ?>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="StartKikimora">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1
      </Publish>
<?endif ?>
    </UI>

    <Condition Message="Kikimora requires 64-bit Windows 10 build 1803 (17134) or newer (AF_UNIX sockets).">
      <![CDATA[Installed OR (VersionNT >= 603 AND Msix64 AND KIKIMORA_WIN_BUILD >= 17134)]]>
    </Condition>
    <Property Id="KIKIMORA_WIN_BUILD" Secure="yes">
      <RegistrySearch Id="KikimoraWinBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Win64="yes" />
    </Property>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramMenuFolder">
        <!-- The all-users Startup folder. It MUST carry a Name and live under
             ProgramMenuFolder: a bare Directory under TARGETDIR resolves to
             C:\, and the startup shortcut landed in the filesystem root
             (found by the 2026-10-28 install acceptance). -->
<?ifdef UiPresented ?>
        <Directory Id="CommonStartup" Name="StartUp">
          <!-- The autostart entry: same HKCU-KeyPath pattern as the menu
               shortcut (ICE43/57), plus RemoveFolder for the folder (ICE64). -->
          <Component Id="UiStartupShortcut" Guid="{A3C91E52-6F8B-4D1A-9E47-20B5C3D6F802}">
            <RegistryValue Root="HKCU" Key="Software\Kikimora" Name="StartupShortcut"
                           Type="integer" Value="1" KeyPath="yes" />
            <Shortcut Id="KikimoraStartupShortcut" Name="Kikimora"
                      Target="[UISUBDIR]kikimora-ui.exe" Arguments="--background"
                      WorkingDirectory="UISUBDIR" />
            <RemoveFolder Id="RemoveCommonStartup" Directory="CommonStartup" On="uninstall" />
          </Component>
        </Directory>
<?endif ?>
<?ifdef UiPresented ?>
        <Directory Id="KikimoraMenuDir" Name="Kikimora">
          <!-- A visible Start menu entry. Per-user shortcuts in a per-machine
               package need an HKCU KeyPath component of their own (ICE43/57),
               and the menu directory needs RemoveFolder (ICE64). -->
          <Component Id="UiMenuShortcut" Guid="{7E1F4B5C-9A2D-4E8F-B3C6-51D2A0F7E901}">
            <RegistryValue Root="HKCU" Key="Software\Kikimora" Name="StartMenuShortcut"
                           Type="integer" Value="1" KeyPath="yes" />
            <Shortcut Id="KikimoraMenuShortcut" Name="Kikimora"
                      Target="[UISUBDIR]kikimora-ui.exe" WorkingDirectory="UISUBDIR" />
            <RemoveFolder Id="RemoveKikimoraMenuDir" Directory="KikimoraMenuDir" On="uninstall" />
          </Component>
        </Directory>
<?endif ?>
      </Directory>
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLROOT" Name="Kikimora">
<?ifdef UiPresented ?>
          <Directory Id="UISUBDIR" Name="ui">
            <Component Id="UiExe" Guid="{93C2D8C4-3F61-4E8D-8A33-7D402B73C303}">
              <File Id="KikimoraUiExe" Name="kikimora-ui.exe" Source="$(var.PackageDir)\kikimora-ui.exe" KeyPath="yes" Checksum="yes" />
            </Component>
          </Directory>
<?endif ?>

          <Component Id="CoreExe" Guid="{4F1C4E33-6D47-4C6A-9C36-2A16E7D5A101}">
            <File Id="KikimoraCoreExe" Name="kikimora-core.exe" Source="$(var.PackageDir)\kikimora-core.exe" KeyPath="yes" Checksum="yes" />
            <ServiceInstall Id="CoreServiceInstall"
                            Name="$(var.ServiceName)"
                            DisplayName="Kikimora Core"
                            Description="Kikimora VPN control plane service (supervises Toad processes and the local control IPC)"
                            Type="ownProcess"
                            Start="auto"
                            ErrorControl="normal"
                            Vital="yes"
                            Arguments="serve" />
            <ServiceControl Id="CoreServiceControl"
                            Name="$(var.ServiceName)"
                            Start="install"
                            Stop="both"
                            Remove="uninstall"
                            Wait="yes" />
          </Component>
          <Component Id="ToadExe" Guid="{7B0F8F62-2A54-4C2B-9D57-6C3F1A62B202}">
            <File Id="KikimoraToadExe" Name="kikimora-toad.exe" Source="$(var.PackageDir)\kikimora-toad.exe" KeyPath="yes" Checksum="yes" />
          </Component>
          <!-- The Wintun redistributable is a hard payload dependency: the Toad
               platform layer loads wintun.dll from the binary directory or
               System32 only. stage.ps1 refuses to build a release package
               without it, so this component is present whenever the DLL is. -->
<?ifdef WintunPresented ?>
          <Component Id="WintunDll" Guid="{6E4A1F58-3D07-4C9B-8F21-9A5C7D04E707}">
            <File Id="KikimoraWintunDll" Name="wintun.dll" Source="$(var.PackageDir)\wintun.dll" KeyPath="yes" Checksum="yes" />
          </Component>
<?endif ?>
<?ifdef UiPresented ?>
          
<?endif ?>
        </Directory>
      </Directory>

      <Directory Id="CommonAppDataFolder">
        <Directory Id="DATAROOT" Name="Kikimora">
          <Component Id="DataRootDir" Guid="{A5D91E10-8C74-4B39-9A64-1E8F2D74C404}">
            <CreateFolder>
              <util:PermissionEx User="SYSTEM" GenericAll="yes" />
              <util:PermissionEx User="Administrators" GenericAll="yes" />
            </CreateFolder>
            <RegistryValue Root="HKLM" Key="Software\Kikimora"
                           Name="dataroot" Type="string" Value="[DATAROOT]" KeyPath="yes" />
          </Component>
          <!-- The ownership template mirrors the Linux conffile contract:
               laid down only when missing (NeverOverwrite), preserved on
               upgrade, kept on uninstall, purged only manually. -->
          <Component Id="OwnershipConf" Guid="{5D3E8A27-9C41-4B6F-B2D8-1E7A4C9F5B63}" Permanent="yes" NeverOverwrite="yes">
            <File Id="OwnershipConfFile" Name="ownership.conf" Source="$(var.PackageDir)\ownership.conf" KeyPath="yes" Checksum="yes" />
          </Component>
          <Directory Id="DATAROOTSTATE" Name="state">
            <Component Id="DataStateDir" Guid="{C63F52B9-9E85-4F47-B075-2F9A3E85D505}">
              <CreateFolder>
                <!-- The state directory holds desired-state JSON and the control
                     socket; SYSTEM and Administrators only. -->
                <util:PermissionEx User="SYSTEM" GenericAll="yes" />
                <util:PermissionEx User="Administrators" GenericAll="yes" />
              </CreateFolder>
              <RegistryValue Root="HKLM" Key="Software\Kikimora\state"
                             Name="path" Type="string" Value="[DATAROOT]state" KeyPath="yes" />
            </Component>
          </Directory>
          <Directory Id="DATAROOTTOADS" Name="toads">
            <Component Id="DataToadsDir" Guid="{E84B63CA-AF96-4508-8186-3FAB4F96E606}">
              <CreateFolder />
              <!-- util:PermissionEx only ADDS ACEs to the inherited DACL, and
                   ProgramData hands BUILTIN\Users read+create: role TOMLs
                   carry private keys, so the four data directories are
                   re-hardened to SYSTEM/Administrators by the deferred
                   HardenDataDirs action below. -->
              <RegistryValue Root="HKLM" Key="Software\Kikimora\toads"
                             Name="path" Type="string" Value="[DATAROOT]toads" KeyPath="yes" />
            </Component>
          </Directory>
          <Directory Id="DATAROOTLOGS" Name="logs">
            <Component Id="DataLogsDir" Guid="{0F5C74DB-B0A7-5619-9297-4FBC5FA7F707}">
              <CreateFolder />
              <RegistryValue Root="HKLM" Key="Software\Kikimora\logs"
                             Name="path" Type="string" Value="[DATAROOT]logs" KeyPath="yes" />
            </Component>
          </Directory>
          <Directory Id="DATAROOTLESHY" Name="leshy">
            <Directory Id="DATAROOTLESHYVPN" Name="vpn">
              <Component Id="DataLeshyDir" Guid="{21AD85EC-C1B8-672A-A3A8-5FCD6AB8A808}">
                <CreateFolder />
                <RegistryValue Root="HKLM" Key="Software\Kikimora\leshy"
                               Name="path" Type="string" Value="[DATAROOT]leshy" KeyPath="yes" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="Kikimora" Level="1">
      <ComponentRef Id="CoreExe" />
      <ComponentRef Id="ToadExe" />
<?ifdef WintunPresented ?>
      <ComponentRef Id="WintunDll" />
<?endif ?>
<?ifdef UiPresented ?>
      <ComponentRef Id="UiExe" />
      <ComponentRef Id="UiMenuShortcut" />
      <ComponentRef Id="UiStartupShortcut" />
<?endif ?>
<?ifdef UiPresented ?>
      <ComponentGroupRef Id="UiPayload" />
<?endif ?>
      <ComponentRef Id="DataRootDir" />
      <ComponentRef Id="OwnershipConf" />
      <ComponentRef Id="DataStateDir" />
      <ComponentRef Id="DataToadsDir" />
      <ComponentRef Id="DataLogsDir" />
      <ComponentRef Id="DataLeshyDir" />
    </Feature>

    <!-- The service binary self-configures staged restart recovery on its
         first SCM start; the MSI keeps the registration declarative. -->
  </Product>
</Wix>
