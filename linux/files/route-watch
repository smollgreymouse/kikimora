#!/usr/bin/env bash
set -Eeuo pipefail

readonly script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly vpn_runtime_dir="${KIKIMORA_VPN_RUNTIME_DIR:-/run/kikimora/leshy/vpn}"
readonly lifecycle_state_dir="${KIKIMORA_ROUTE_LIFECYCLE_STATE_DIR:-/run/kikimora/leshy/route-lifecycle}"
readonly watch_state_dir="${KIKIMORA_ROUTE_WATCH_STATE_DIR:-/run/kikimora/leshy/route-watch}"
readonly endpoint_state_dir="${KIKIMORA_ENDPOINT_STATE_DIR:-/run/kikimora/leshy/endpoint-underlay}"
readonly endpoints_dir="${KIKIMORA_ENDPOINTS_DIR:-/etc/kikimora/leshy/endpoints}"
readonly endpoint_providers_dir="${KIKIMORA_ENDPOINT_PROVIDERS_DIR:-${script_dir}/endpoint-providers}"
readonly vpn_config="${KIKIMORA_VPN_CONFIG:-/etc/kikimora/leshy/vpn.conf}"
readonly devices_file="${lifecycle_state_dir}/devices"
readonly active_file="${watch_state_dir}/active.devices"
readonly lifecycle="${KIKIMORA_ROUTE_LIFECYCLE:-/usr/local/libexec/kikimora/leshy/route-lifecycle}"
readonly reconcile="${KIKIMORA_RECONCILE:-/usr/local/libexec/kikimora/leshy/reconcile}"
readonly systemctl_cmd="${KIKIMORA_SYSTEMCTL:-systemctl}"
readonly interval_seconds="${LESHY_ROUTE_WATCH_INTERVAL:-1}"
readonly max_iterations="${KIKIMORA_ROUTE_WATCH_MAX_ITERATIONS:-0}"
readonly endpoint_reconcile_iterations="${KIKIMORA_ENDPOINT_RECONCILE_ITERATIONS:-5}"
readonly endpoint_table="${KIKIMORA_ENDPOINT_ROUTE_TABLE:-51890}"
readonly primary_rule_priority="${KIKIMORA_PRIMARY_ENDPOINT_RULE_PRIORITY:-50}"
readonly secondary_rule_priority="${KIKIMORA_SECONDARY_ENDPOINT_RULE_PRIORITY:-51}"

log() {
    printf 'leshy-route-watch: %s\n' "$*" >&2
}

read_runtime_devices() {
    local file value
    shopt -s nullglob

    for file in "${vpn_runtime_dir}"/*.dev; do
        while IFS= read -r value || [[ -n ${value} ]]; do
            value=${value%%#*}
            value=${value//$'\r'/}
            value=${value#"${value%%[![:space:]]*}"}
            value=${value%"${value##*[![:space:]]}"}
            [[ -n ${value} ]] || continue
            [[ ${value} != *[[:space:]/]* ]] || continue
            printf '%s\n' "${value}"
        done < "${file}"
    done | LC_ALL=C sort -u
}

log_reconcile_transition() {
    local output="$1" line

    [[ -n "$output" ]] || return 0
    while IFS= read -r line; do
        log "reconcile: ${line}"
    done <<< "$output"
}

flush_dns_caches() {
    command -v resolvectl >/dev/null 2>&1 || {
        log 'resolvectl not found; DNS cache flush skipped'
        return 0
    }

    if resolvectl flush-caches >/dev/null 2>&1; then
        log 'systemd-resolved DNS cache flushed after VPN readiness change'
    else
        log 'failed to flush systemd-resolved DNS cache after VPN readiness change'
    fi
}

refresh_leshy_after_vpn_ready() {
    command -v "${systemctl_cmd}" >/dev/null 2>&1 || {
        log 'systemctl not found; Leshy DNS route-cache refresh skipped'
        return 0
    }

    if ! "${systemctl_cmd}" is-active --quiet leshy.service >/dev/null 2>&1; then
        log 'Leshy is not active; DNS route-cache refresh skipped'
        return 0
    fi

    if ! "${lifecycle}" prepare-restart >/dev/null 2>&1; then
        log 'Failed to prepare route lifecycle for Leshy restart; cached route refresh skipped to preserve parked routes'
        return 0
    fi

    if "${systemctl_cmd}" try-restart leshy.service >/dev/null 2>&1; then
        log 'Leshy restarted after VPN became ready so cached route-add failures are retried'
    else
        log 'Failed to restart Leshy after VPN became ready; cached route-add failures may persist'
    fi
}

ensure_endpoint_config() {
    local file

    install -d -m 0755 "${endpoints_dir}"
    for file in primary.txt secondary.txt; do
        [[ -e "${endpoints_dir}/${file}" ]] && continue
        cat > "${endpoints_dir}/${file}" <<'EOF_ENDPOINTS'
# Exact VPN endpoint hostnames or IP addresses, one per line.
# These addresses are always routed through the physical underlay while Kikimora is running.
# Wildcards and parent-domain matching are intentionally not supported.
EOF_ENDPOINTS
        chmod 0644 "${endpoints_dir}/${file}"
    done
}

load_managed_interfaces() {
    PRIMARY_INTERFACE=''
    SECONDARY_INTERFACE=''
    PRIMARY_ENDPOINT_PROVIDER='static'
    SECONDARY_ENDPOINT_PROVIDER='static'
    PRIMARY_ENDPOINT_PROVIDER_ARGS=''
    SECONDARY_ENDPOINT_PROVIDER_ARGS=''
    if [[ -r ${vpn_config} ]]; then
        # shellcheck disable=SC1090
        source "${vpn_config}"
        PRIMARY_INTERFACE="${PRIMARY_INTERFACE:-${AMN_IFACE:-}}"
        SECONDARY_INTERFACE="${SECONDARY_INTERFACE:-${VPN_IFACE:-}}"
        PRIMARY_ENDPOINT_PROVIDER="${PRIMARY_ENDPOINT_PROVIDER:-static}"
        SECONDARY_ENDPOINT_PROVIDER="${SECONDARY_ENDPOINT_PROVIDER:-static}"
        PRIMARY_ENDPOINT_PROVIDER_ARGS="${PRIMARY_ENDPOINT_PROVIDER_ARGS:-}"
        SECONDARY_ENDPOINT_PROVIDER_ARGS="${SECONDARY_ENDPOINT_PROVIDER_ARGS:-}"
    fi
}

role_interface() {
    case "$1" in
        primary) printf '%s\n' "${PRIMARY_INTERFACE:-}" ;;
        secondary) printf '%s\n' "${SECONDARY_INTERFACE:-}" ;;
        *) return 64 ;;
    esac
}

role_provider() {
    case "$1" in
        primary) printf '%s\n' "${PRIMARY_ENDPOINT_PROVIDER:-static}" ;;
        secondary) printf '%s\n' "${SECONDARY_ENDPOINT_PROVIDER:-static}" ;;
        *) return 64 ;;
    esac
}

role_provider_args() {
    case "$1" in
        primary) printf '%s\n' "${PRIMARY_ENDPOINT_PROVIDER_ARGS:-}" ;;
        secondary) printf '%s\n' "${SECONDARY_ENDPOINT_PROVIDER_ARGS:-}" ;;
        *) return 64 ;;
    esac
}

role_priority() {
    case "$1" in
        primary) printf '%s\n' "${primary_rule_priority}" ;;
        secondary) printf '%s\n' "${secondary_rule_priority}" ;;
        *) return 64 ;;
    esac
}

interface_vpn_active() {
    local dev="$1"
    [[ -n ${dev} ]] || return 1

    ip -o link show dev "${dev}" 2>/dev/null |
        grep -qE '<[^>]*UP[^>]*>' || return 1

    ip -4 -o address show dev "${dev}" 2>/dev/null |
        grep -qE 'inet[[:space:]]+[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/'
}

is_managed_interface() {
    local dev="$1"
    [[ -n ${dev} ]] || return 0
    [[ ${dev} == lo || ${dev} == leshy-dns0 ]] && return 0
    [[ -n ${PRIMARY_INTERFACE:-} && ${dev} == "${PRIMARY_INTERFACE}" ]] && return 0
    [[ -n ${SECONDARY_INTERFACE:-} && ${dev} == "${SECONDARY_INTERFACE}" ]] && return 0
    return 1
}

validate_endpoint_spec() {
    local role="$1" value="$2"
    value=${value%.}
    [[ ${value} != *'*'* ]] || {
        log "Invalid ${role} endpoint '${value}': wildcards are not supported"
        return 64
    }
    [[ ${value} != *[[:space:]/]* ]] || {
        log "Invalid ${role} endpoint '${value}'"
        return 64
    }
    [[ ${value} =~ ^[[:alnum:]][[:alnum:]_.:-]*$ ]] || {
        log "Invalid ${role} endpoint '${value}'"
        return 64
    }
    printf '%s\n' "${value,,}"
}

provider_underlay_device() {
    local route="$1"
    if parse_default_route "$route"; then
        printf '%s\n' "${UNDERLAY_DEVICE}"
    fi
}

load_role_endpoint_specs() {
    local role="$1" iface="$2" underlay4="$3" underlay6="$4"
    local provider provider_args provider_path output line value mode_value underlay4_dev underlay6_dev

    ENDPOINT_PROVIDER_MODE='static'
    ENDPOINT_PROVIDER_SPECS=()

    provider="$(role_provider "$role")"
    provider_args="$(role_provider_args "$role")"
    [[ "$provider" =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]] || {
        log "Invalid ${role} endpoint provider name: ${provider}"
        return 64
    }

    provider_path="${endpoint_providers_dir}/${provider}"
    [[ -x "$provider_path" && -f "$provider_path" ]] || {
        log "${role^} endpoint provider not found or not executable: ${provider_path}"
        return 66
    }

    underlay4_dev="$(provider_underlay_device "$underlay4")"
    underlay6_dev="$(provider_underlay_device "$underlay6")"

    if ! output="$(
        KIKIMORA_ENDPOINT_ROLE="$role" \
        KIKIMORA_ENDPOINT_INTERFACE="$iface" \
        KIKIMORA_ENDPOINTS_DIR="$endpoints_dir" \
        KIKIMORA_VPN_CONFIG="$vpn_config" \
        KIKIMORA_UNDERLAY4_DEVICE="$underlay4_dev" \
        KIKIMORA_UNDERLAY6_DEVICE="$underlay6_dev" \
        "$provider_path" "$role" "$provider_args"
    )"; then
        log "${role^} endpoint provider '${provider}' failed; previous policy kept"
        return 1
    fi

    while IFS= read -r line || [[ -n ${line} ]]; do
        value=${line//$'\r'/}
        value=${value#"${value%%[![:space:]]*}"}
        value=${value%"${value##*[![:space:]]}"}
        [[ -n ${value} ]] || continue

        if [[ ${value} =~ ^#[[:space:]]*kikimora-endpoint-provider-mode:[[:space:]]*([[:alnum:]-]+)[[:space:]]*$ ]]; then
            mode_value="${BASH_REMATCH[1],,}"
            case "$mode_value" in
                static|dynamic-additive) ENDPOINT_PROVIDER_MODE="$mode_value" ;;
                *) log "${role^} endpoint provider '${provider}' returned invalid mode: ${mode_value}"; return 64 ;;
            esac
            continue
        fi
        [[ ${value} == \#* ]] && continue
        value="$(validate_endpoint_spec "$role" "$value")" || return $?
        ENDPOINT_PROVIDER_SPECS+=("$value")
    done <<< "$output"

    if ((${#ENDPOINT_PROVIDER_SPECS[@]} > 0)); then
        mapfile -t ENDPOINT_PROVIDER_SPECS < <(printf '%s\n' "${ENDPOINT_PROVIDER_SPECS[@]}" | LC_ALL=C sort -u)
    fi
}

resolve_endpoint_addresses() {
    local spec="$1" family="$2" output=''

    if [[ ${family} == 4 && ${spec} =~ ^[0-9]+(\.[0-9]+){3}$ ]]; then
        printf '%s\n' "${spec}"
        return 0
    fi
    if [[ ${family} == 6 && ${spec} == *:* ]]; then
        printf '%s\n' "${spec}"
        return 0
    fi
    [[ ${spec} != *:* && ! ${spec} =~ ^[0-9]+(\.[0-9]+){3}$ ]] || return 0

    if [[ ${family} == 4 ]]; then
        output="$(getent ahostsv4 "${spec}" 2>/dev/null | awk '$1 ~ /^[0-9]+\./ {print $1}' | LC_ALL=C sort -u || true)"
    else
        # glibc may synthesize IPv4-mapped answers such as ::ffff:46.243.227.103
        # for an IPv4-only hostname. They are not real AAAA endpoints and must
        # not create IPv6 policy rules/routes.
        output="$(getent ahostsv6 "${spec}" 2>/dev/null | awk '$1 ~ /:/ && tolower($1) !~ /^::ffff:/ {print $1}' | LC_ALL=C sort -u || true)"
    fi
    [[ -n ${output} ]] && printf '%s\n' "${output}"
}

select_underlay_default() {
    local family="$1" line dev metric token next i
    local best_line='' best_metric=2147483647
    local -a fields

    while IFS= read -r line; do
        [[ -n ${line} ]] || continue
        read -r -a fields <<< "${line}"
        dev=''
        metric=0
        for ((i=0; i<${#fields[@]}; i++)); do
            token="${fields[i]}"
            next="${fields[i+1]:-}"
            case "${token}" in
                dev) dev="${next}" ;;
                metric) [[ ${next} =~ ^[0-9]+$ ]] && metric="${next}" ;;
            esac
        done
        [[ -n ${dev} ]] || continue
        is_managed_interface "${dev}" && continue
        if ((metric < best_metric)); then
            best_metric="${metric}"
            best_line="${line}"
        fi
    done < <(ip "-${family}" route show table main default 2>/dev/null || true)

    printf '%s\n' "${best_line}"
}

parse_default_route() {
    local line="$1" token next i
    local -a fields
    UNDERLAY_GATEWAY=''
    UNDERLAY_DEVICE=''
    [[ -n ${line} ]] || return 1

    read -r -a fields <<< "${line}"
    for ((i=0; i<${#fields[@]}; i++)); do
        token="${fields[i]}"
        next="${fields[i+1]:-}"
        case "${token}" in
            via) UNDERLAY_GATEWAY="${next}" ;;
            dev) UNDERLAY_DEVICE="${next}" ;;
        esac
    done
    [[ -n ${UNDERLAY_DEVICE} ]]
}

clear_role_rules_family() {
    local role="$1" family="$2" priority
    priority="$(role_priority "${role}")"
    while ip "-${family}" rule del priority "${priority}" lookup "${endpoint_table}" >/dev/null 2>&1; do
        :
    done
}

clear_legacy_rules_family() {
    local family="$1"
    while ip "-${family}" rule del priority "${primary_rule_priority}" lookup "${endpoint_table}" >/dev/null 2>&1; do
        :
    done
}

policy_rules_exist() {
    ip -4 rule show 2>/dev/null | grep -Eq "(^|[[:space:]])lookup ${endpoint_table}([[:space:]]|$)" ||
        ip -6 rule show 2>/dev/null | grep -Eq "(^|[[:space:]])lookup ${endpoint_table}([[:space:]]|$)"
}

maybe_flush_endpoint_table() {
    policy_rules_exist && return 0
    ip -4 route flush table "${endpoint_table}" >/dev/null 2>&1 || true
    ip -6 route flush table "${endpoint_table}" >/dev/null 2>&1 || true
}

install_role_policy_family() {
    local role="$1" family="$2" default_route="$3" priority address prefix
    shift 3
    local -a addresses=("$@")

    priority="$(role_priority "${role}")"
    clear_role_rules_family "${role}" "${family}"
    ((${#addresses[@]} > 0)) || return 0

    ip "-${family}" route replace unreachable default table "${endpoint_table}" metric 32767

    if parse_default_route "${default_route}"; then
        for address in "${addresses[@]}"; do
            [[ ${family} == 4 ]] && prefix="${address}/32" || prefix="${address}/128"
            if [[ -n ${UNDERLAY_GATEWAY} ]]; then
                ip "-${family}" route replace "${prefix}" via "${UNDERLAY_GATEWAY}" dev "${UNDERLAY_DEVICE}" onlink table "${endpoint_table}" metric 1
            else
                ip "-${family}" route replace "${prefix}" dev "${UNDERLAY_DEVICE}" table "${endpoint_table}" metric 1
            fi
        done
    fi

    for address in "${addresses[@]}"; do
        [[ ${family} == 4 ]] && prefix="${address}/32" || prefix="${address}/128"
        ip "-${family}" rule add priority "${priority}" to "${prefix}" lookup "${endpoint_table}"
    done
}

add_role_policy_family() {
    local role="$1" family="$2" default_route="$3" priority address prefix
    shift 3
    local -a addresses=("$@")

    ((${#addresses[@]} > 0)) || return 0
    parse_default_route "$default_route" || return 1
    priority="$(role_priority "$role")"
    ip "-${family}" route replace unreachable default table "${endpoint_table}" metric 32767

    for address in "${addresses[@]}"; do
        [[ ${family} == 4 ]] && prefix="${address}/32" || prefix="${address}/128"
        if [[ -n ${UNDERLAY_GATEWAY} ]]; then
            ip "-${family}" route replace "${prefix}" via "${UNDERLAY_GATEWAY}" dev "${UNDERLAY_DEVICE}" onlink table "${endpoint_table}" metric 1
        else
            ip "-${family}" route replace "${prefix}" dev "${UNDERLAY_DEVICE}" table "${endpoint_table}" metric 1
        fi
        ip "-${family}" rule add priority "${priority}" to "${prefix}" lookup "${endpoint_table}"
    done
}

current_role_rule_addresses_family() {
    local role="$1" family="$2" priority
    priority="$(role_priority "${role}")"
    ip "-${family}" rule show 2>/dev/null | awk -v priority="${priority}:" -v table="${endpoint_table}" '
        $1 == priority {
            destination=""
            lookup=""
            for (i = 1; i <= NF; i++) {
                if ($i == "to") destination=$(i + 1)
                if ($i == "lookup") lookup=$(i + 1)
            }
            if (lookup == table && destination != "") {
                sub(/\/(32|128)$/, "", destination)
                print destination
            }
        }
    ' | LC_ALL=C sort -u
}

current_role_rules_match_family() {
    local role="$1" family="$2" actual expected
    shift 2
    local -a addresses=("$@")

    actual="$(current_role_rule_addresses_family "$role" "$family")"
    expected=''
    if ((${#addresses[@]} > 0)); then
        expected="$(printf '%s\n' "${addresses[@]}" | LC_ALL=C sort -u)"
    fi
    [[ ${actual} == "${expected}" ]]
}

array_contains() {
    local needle="$1" item
    shift
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

current_routes_are_direct() {
    local underlay4="$1" underlay6="$2" address route dev via
    local expected4='' expected6='' gateway4='' gateway6=''
    shift 2
    local -a addresses4=() addresses6=()
    local parsing6=0 item

    for item in "$@"; do
        if [[ ${item} == --v6 ]]; then
            parsing6=1
            continue
        fi
        if ((parsing6 == 0)); then addresses4+=("${item}"); else addresses6+=("${item}"); fi
    done

    if parse_default_route "${underlay4}"; then
        expected4="${UNDERLAY_DEVICE}"
        gateway4="${UNDERLAY_GATEWAY}"
    fi
    if parse_default_route "${underlay6}"; then
        expected6="${UNDERLAY_DEVICE}"
        gateway6="${UNDERLAY_GATEWAY}"
    fi

    for address in "${addresses4[@]}"; do
        [[ -n ${expected4} ]] || return 1
        route="$(ip -4 route get "${address}" 2>/dev/null | head -n1 || true)"
        dev="$(awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}' <<< "${route}")"
        via="$(awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}' <<< "${route}")"
        [[ ${dev} == "${expected4}" && ${via} == "${gateway4}" ]] || return 1
    done
    for address in "${addresses6[@]}"; do
        [[ -n ${expected6} ]] || return 1
        route="$(ip -6 route get "${address}" 2>/dev/null | head -n1 || true)"
        dev="$(awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}' <<< "${route}")"
        via="$(awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}' <<< "${route}")"
        [[ ${dev} == "${expected6}" && ${via} == "${gateway6}" ]] || return 1
    done
    return 0
}

underlay_route_identity() {
    local route="$1"

    if parse_default_route "$route"; then
        printf 'dev=%s via=%s\n' "$UNDERLAY_DEVICE" "$UNDERLAY_GATEWAY"
    else
        printf 'none\n'
    fi
}

underlay_identity() {
    local underlay4="$1" underlay6="$2"
    local identity4 identity6

    identity4="$(underlay_route_identity "$underlay4")"
    identity6="$(underlay_route_identity "$underlay6")"

    printf 'underlay4=%s\nunderlay6=%s\n' "$identity4" "$identity6" |
        sha256sum | awk '{print $1}'
}

mark_role_pending() {
    local role="$1" iface="$2" pending_file="$3" reason="$4" pending_state
    install -d -m 0755 "${endpoint_state_dir}"
    pending_state="interface=${iface} ${reason}"
    if [[ ! -r ${pending_file} ]] || [[ "$(<"${pending_file}")" != "${pending_state}" ]]; then
        printf '%s\n' "${pending_state}" > "${pending_file}"
        log "${role^} endpoint underlay pending: ${iface:-<unset>} is active; ${reason}."
    fi
}

migrate_legacy_policy_if_safe() {
    local legacy_signature="${endpoint_state_dir}/signature"
    [[ -e ${legacy_signature} ]] || return 0

    if interface_vpn_active "${PRIMARY_INTERFACE:-}" || interface_vpn_active "${SECONDARY_INTERFACE:-}"; then
        install -d -m 0755 "${endpoint_state_dir}"
        printf 'legacy-policy-migration-waits-for-both-vpns-down\n' > "${endpoint_state_dir}/migration.pending"
        log 'Endpoint underlay migration pending: disconnect both managed VPN interfaces once before applying the new safe lifecycle.'
        return 1
    fi

    clear_legacy_rules_family 4
    clear_legacy_rules_family 6
    ip -4 route flush table "${endpoint_table}" >/dev/null 2>&1 || true
    ip -6 route flush table "${endpoint_table}" >/dev/null 2>&1 || true
    rm -f -- "${legacy_signature}" "${endpoint_state_dir}/migration.pending"
    log 'Migrated draft endpoint-underlay policy while both VPN interfaces were down.'
}

reconcile_endpoint_role() {
    local role="$1" iface provider_mode spec address underlay4 underlay6 signature previous='' found unresolved=0 pending_state
    local policy_matches=0 adopt_live_signature=0 current_underlay previous_underlay=''
    local signature_file="${endpoint_state_dir}/${role}.signature"
    local pending_file="${endpoint_state_dir}/${role}.pending"
    local underlay_file="${endpoint_state_dir}/${role}.underlay"
    local -a endpoint_specs=() addresses4=() addresses6=()
    local -a current4=() current6=() missing4=() missing6=() effective4=() effective6=() combined=()

    iface="$(role_interface "${role}")"
    underlay4="$(select_underlay_default 4)"
    underlay6="$(select_underlay_default 6)"

    if ! load_role_endpoint_specs "${role}" "${iface}" "${underlay4}" "${underlay6}"; then
        if interface_vpn_active "${iface}"; then
            mark_role_pending "$role" "$iface" "$pending_file" "endpoint provider discovery failed"
        fi
        return 1
    fi
    provider_mode="$ENDPOINT_PROVIDER_MODE"
    endpoint_specs=("${ENDPOINT_PROVIDER_SPECS[@]}")

    for spec in "${endpoint_specs[@]}"; do
        found=0
        while IFS= read -r address; do
            [[ -n ${address} ]] || continue
            addresses4+=("${address}")
            found=1
        done < <(resolve_endpoint_addresses "${spec}" 4)
        while IFS= read -r address; do
            [[ -n ${address} ]] || continue
            addresses6+=("${address}")
            found=1
        done < <(resolve_endpoint_addresses "${spec}" 6)
        if ((found == 0)); then
            log "${role^} endpoint '${spec}' did not resolve; keeping previous policy"
            unresolved=1
        fi
    done
    ((unresolved == 0)) || return 1

    if ((${#addresses4[@]} > 0)); then
        mapfile -t addresses4 < <(printf '%s\n' "${addresses4[@]}" | LC_ALL=C sort -u)
    fi
    if ((${#addresses6[@]} > 0)); then
        mapfile -t addresses6 < <(printf '%s\n' "${addresses6[@]}" | LC_ALL=C sort -u)
    fi

    [[ -r ${signature_file} ]] && previous="$(<"${signature_file}")"
    current_underlay="$(underlay_identity "$underlay4" "$underlay6")"
    [[ -r ${underlay_file} ]] && previous_underlay="$(<"${underlay_file}")"

    if [[ ${provider_mode} == dynamic-additive ]] && interface_vpn_active "${iface}"; then
        mapfile -t current4 < <(current_role_rule_addresses_family "$role" 4)
        mapfile -t current6 < <(current_role_rule_addresses_family "$role" 6)

        # Upgrade compatibility: old signatures already included the selected
        # physical default. Prove the currently installed routes still match it
        # before creating the separate underlay identity used by dynamic providers.
        if [[ -n ${previous} && -z ${previous_underlay} ]]; then
            if current_routes_are_direct "${underlay4}" "${underlay6}" "${current4[@]}" --v6 "${current6[@]}"; then
                install -d -m 0755 "${endpoint_state_dir}"
                printf '%s\n' "${current_underlay}" > "${underlay_file}"
                previous_underlay="$current_underlay"
            else
                mark_role_pending "$role" "$iface" "$pending_file" 'installed endpoint policy no longer matches the physical underlay'
                return 0
            fi
        fi

        # A physical default change is not an additive endpoint change. Never
        # rewrite existing live transport routes onto another underlay.
        if [[ -n ${previous_underlay} && ${previous_underlay} != "${current_underlay}" ]]; then
            mark_role_pending "$role" "$iface" "$pending_file" 'physical underlay changed; disconnect this VPN once before moving existing endpoint routes'
            return 0
        fi

        if ! current_routes_are_direct "${underlay4}" "${underlay6}" "${current4[@]}" --v6 "${current6[@]}"; then
            mark_role_pending "$role" "$iface" "$pending_file" 'installed endpoint routes are not on the selected physical underlay'
            return 0
        fi

        for address in "${addresses4[@]}"; do
            array_contains "$address" "${current4[@]}" || missing4+=("$address")
        done
        for address in "${addresses6[@]}"; do
            array_contains "$address" "${current6[@]}" || missing6+=("$address")
        done

        # dynamic-additive is a trusted provider capability: newly emitted
        # endpoints must be live transports already observed on the physical
        # underlay. Core only adds them. Existing endpoint rules are never
        # deleted or rewritten while the role interface is active.
        if ! add_role_policy_family "$role" 4 "$underlay4" "${missing4[@]}" ||
           ! add_role_policy_family "$role" 6 "$underlay6" "${missing6[@]}"; then
            mark_role_pending "$role" "$iface" "$pending_file" 'new dynamic endpoint could not be installed on the physical underlay'
            return 0
        fi

        combined=("${current4[@]}" "${addresses4[@]}")
        if ((${#combined[@]} > 0)); then
            mapfile -t effective4 < <(printf '%s\n' "${combined[@]}" | LC_ALL=C sort -u)
        fi
        combined=("${current6[@]}" "${addresses6[@]}")
        if ((${#combined[@]} > 0)); then
            mapfile -t effective6 < <(printf '%s\n' "${combined[@]}" | LC_ALL=C sort -u)
        fi

        signature="$({
            printf 'role=%s\nunderlay4=%s\nunderlay6=%s\n' "${role}" "${underlay4}" "${underlay6}"
            printf 'v4=%s\n' "${effective4[@]}"
            printf 'v6=%s\n' "${effective6[@]}"
        } | sha256sum | awk '{print $1}')"

        install -d -m 0755 "${endpoint_state_dir}"
        printf '%s\n' "${signature}" > "${signature_file}"
        printf '%s\n' "${current_underlay}" > "${underlay_file}"
        rm -f -- "${pending_file}"
        maybe_flush_endpoint_table
        if ((${#missing4[@]} > 0 || ${#missing6[@]} > 0)); then
            log "${role^} dynamic endpoint underlay extended live: +IPv4=${#missing4[@]} +IPv6=${#missing6[@]} provider=$(role_provider "$role")"
        fi
        return 0
    fi

    signature="$({
        printf 'role=%s\nunderlay4=%s\nunderlay6=%s\n' "${role}" "${underlay4}" "${underlay6}"
        printf 'v4=%s\n' "${addresses4[@]}"
        printf 'v6=%s\n' "${addresses6[@]}"
    } | sha256sum | awk '{print $1}')"

    if [[ ${signature} == "${previous}" ]]; then
        install -d -m 0755 "${endpoint_state_dir}"
        printf '%s\n' "${current_underlay}" > "${underlay_file}"
        rm -f -- "${pending_file}"
        return 0
    fi

    if interface_vpn_active "${iface}"; then
        if [[ -n ${previous} ]] &&
            current_role_rules_match_family "${role}" 4 "${addresses4[@]}" &&
            current_role_rules_match_family "${role}" 6 "${addresses6[@]}"; then
            policy_matches=1
        fi

        if current_routes_are_direct "${underlay4}" "${underlay6}" "${addresses4[@]}" --v6 "${addresses6[@]}"; then
            if [[ -z ${previous} ]]; then
                :
            elif ((policy_matches == 1)); then
                adopt_live_signature=1
            else
                policy_matches=0
            fi
        else
            policy_matches=0
        fi

        if [[ -n ${previous} ]] && ((adopt_live_signature == 0)); then
            pending_state="interface=${iface} desired=${signature}"
            install -d -m 0755 "${endpoint_state_dir}"
            if [[ ! -r ${pending_file} ]] || [[ "$(<"${pending_file}")" != "${pending_state}" ]]; then
                printf '%s\n' "${pending_state}" > "${pending_file}"
                log "${role^} endpoint underlay pending: ${iface:-<unset>} is active; disconnect that VPN once before changing its endpoint path."
            fi
            return 0
        fi
        if [[ -z ${previous} ]] && ! current_routes_are_direct "${underlay4}" "${underlay6}" "${addresses4[@]}" --v6 "${addresses6[@]}"; then
            pending_state="interface=${iface} desired=${signature}"
            install -d -m 0755 "${endpoint_state_dir}"
            if [[ ! -r ${pending_file} ]] || [[ "$(<"${pending_file}")" != "${pending_state}" ]]; then
                printf '%s\n' "${pending_state}" > "${pending_file}"
                log "${role^} endpoint underlay pending: ${iface:-<unset>} is active; disconnect that VPN once before changing its endpoint path."
            fi
            return 0
        fi
    fi

    install -d -m 0755 "${endpoint_state_dir}"
    if ((adopt_live_signature == 1)); then
        printf '%s\n' "${signature}" > "${signature_file}"
        printf '%s\n' "${current_underlay}" > "${underlay_file}"
        rm -f -- "${pending_file}"
        log "${role^} endpoint underlay signature refreshed: installed policy already matches the live physical path."
        return 0
    fi

    install_role_policy_family "${role}" 4 "${underlay4}" "${addresses4[@]}"
    install_role_policy_family "${role}" 6 "${underlay6}" "${addresses6[@]}"
    printf '%s\n' "${signature}" > "${signature_file}"
    printf '%s\n' "${current_underlay}" > "${underlay_file}"
    rm -f -- "${pending_file}"
    maybe_flush_endpoint_table
    log "${role^} endpoint underlay updated: IPv4=${#addresses4[@]} IPv6=${#addresses6[@]} provider=$(role_provider "$role") physical4='${underlay4:-none}' physical6='${underlay6:-none}'"
}

reconcile_endpoint_underlay() {
    ensure_endpoint_config
    load_managed_interfaces
    install -d -m 0755 "${endpoint_state_dir}"

    if ! migrate_legacy_policy_if_safe; then
        return 0
    fi

    reconcile_endpoint_role primary || log 'Primary endpoint underlay reconcile failed; previous policy kept.'
    reconcile_endpoint_role secondary || log 'Secondary endpoint underlay reconcile failed; previous policy kept.'
}

endpoint_check_clear() {
    load_managed_interfaces
    policy_rules_exist || return 0

    local blocked=0
    if interface_vpn_active "${PRIMARY_INTERFACE:-}"; then
        log "Cannot clear endpoint underlay while primary interface ${PRIMARY_INTERFACE} is active. Disconnect it first or use --force."
        blocked=1
    fi
    if interface_vpn_active "${SECONDARY_INTERFACE:-}"; then
        log "Cannot clear endpoint underlay while secondary interface ${SECONDARY_INTERFACE} is active. Disconnect it first or use --force."
        blocked=1
    fi
    ((blocked == 0))
}

endpoint_clear() {
    local force=0
    [[ ${1:-} == --force ]] && { force=1; shift; }
    (($# == 0)) || { log 'usage: route-watch endpoint clear [--force]'; return 64; }

    if ((force == 0)); then
        endpoint_check_clear || return 75
    fi

    clear_role_rules_family primary 4
    clear_role_rules_family primary 6
    clear_role_rules_family secondary 4
    clear_role_rules_family secondary 6
    clear_legacy_rules_family 4
    clear_legacy_rules_family 6
    ip -4 route flush table "${endpoint_table}" >/dev/null 2>&1 || true
    ip -6 route flush table "${endpoint_table}" >/dev/null 2>&1 || true
    rm -rf -- "${endpoint_state_dir}"
    log 'Endpoint underlay policy cleared.'
}

endpoint_status() {
    load_managed_interfaces
    local role iface provider signature pending
    printf 'VPN endpoint underlay:\n'
    for role in primary secondary; do
        iface="$(role_interface "${role}")"
        provider="$(role_provider "${role}")"
        signature="${endpoint_state_dir}/${role}.signature"
        pending="${endpoint_state_dir}/${role}.pending"
        if [[ -e ${pending} ]]; then
            printf '  %-9s pending  interface=%s provider=%s\n' "${role}" "${iface:-<unset>}" "$provider"
        elif [[ -e ${signature} ]]; then
            printf '  %-9s active   interface=%s provider=%s\n' "${role}" "${iface:-<unset>}" "$provider"
        else
            printf '  %-9s inactive interface=%s provider=%s\n' "${role}" "${iface:-<unset>}" "$provider"
        fi
    done
    [[ -e ${endpoint_state_dir}/migration.pending ]] && printf '  migration pending (disconnect both VPNs once)\n'
}

validate_settings() {
    [[ ${interval_seconds} =~ ^[1-9][0-9]*$ ]] || { log "Invalid interval: ${interval_seconds}"; exit 64; }
    [[ ${max_iterations} =~ ^[0-9]+$ ]] || { log "Invalid max iterations: ${max_iterations}"; exit 64; }
    [[ ${endpoint_reconcile_iterations} =~ ^[1-9][0-9]*$ ]] || { log "Invalid endpoint reconcile iterations: ${endpoint_reconcile_iterations}"; exit 64; }
    [[ ${endpoint_table} =~ ^[1-9][0-9]*$ ]] || { log "Invalid endpoint route table: ${endpoint_table}"; exit 64; }
    [[ ${primary_rule_priority} =~ ^[1-9][0-9]*$ ]] || { log "Invalid primary endpoint rule priority: ${primary_rule_priority}"; exit 64; }
    [[ ${secondary_rule_priority} =~ ^[1-9][0-9]*$ ]] || { log "Invalid secondary endpoint rule priority: ${secondary_rule_priority}"; exit 64; }
    [[ ${primary_rule_priority} != "${secondary_rule_priority}" ]] || { log 'Primary and secondary endpoint rule priorities must differ'; exit 64; }
}

validate_settings

if [[ ${1:-} == endpoint ]]; then
    shift
    case "${1:-status}" in
        apply|reconcile) shift || true; (($# == 0)) || { log 'unexpected endpoint arguments'; exit 64; }; reconcile_endpoint_underlay ;;
        check-clear) shift || true; (($# == 0)) || { log 'unexpected endpoint arguments'; exit 64; }; endpoint_check_clear ;;
        clear) shift || true; endpoint_clear "$@" ;;
        status) shift || true; (($# == 0)) || { log 'unexpected endpoint arguments'; exit 64; }; endpoint_status ;;
        *) log 'usage: route-watch endpoint {apply|reconcile|check-clear|clear [--force]|status}'; exit 64 ;;
    esac
    exit $?
fi

while [[ ! -f ${devices_file} ]]; do
    sleep 0.1
done

install -d -m 0755 "${watch_state_dir}" "${endpoint_state_dir}"
if [[ ! -f ${active_file} ]]; then
    read_runtime_devices > "${active_file}"
fi

log "Route watch and reconcile started; interval ${interval_seconds} s."

last_reconcile_output=''
iterations=0
endpoint_iteration=0
while true; do
    current_file="${watch_state_dir}/active.devices.new"
    readiness_changed=0
    readiness_became_ready=0
    reconcile_output=''

    # Preserve the last exact set of Leshy-owned /32 routes before reconcile
    # can withdraw a device file. If the VPN interface disappears together with
    # its kernel routes, route-lifecycle can still park the cached destinations.
    while IFS= read -r dev; do
        [[ -n ${dev} ]] || continue
        "${lifecycle}" observe-device "${dev}" || true
    done < "${active_file}"

    if reconcile_output=$("${reconcile}" 2>&1); then
        if [[ "$reconcile_output" != "$last_reconcile_output" ]]; then
            log_reconcile_transition "$reconcile_output"
            last_reconcile_output="$reconcile_output"
        fi
    else
        log 'Reconcile errored; using last known state.'
        log_reconcile_transition "$reconcile_output"
        last_reconcile_output=''
    fi

    if ((endpoint_iteration == 0)); then
        reconcile_endpoint_underlay || log 'Endpoint underlay reconcile failed; previous policy kept where possible.'
    fi
    endpoint_iteration=$(((endpoint_iteration + 1) % endpoint_reconcile_iterations))

    read_runtime_devices > "${current_file}"

    while IFS= read -r dev; do
        [[ -n ${dev} ]] || continue
        if ! grep -Fqx -- "${dev}" "${active_file}" 2>/dev/null; then
            "${lifecycle}" begin-device "${dev}" || true
            log "Interface ready: ${dev}"
            readiness_changed=1
            readiness_became_ready=1
        fi
    done < "${current_file}"

    while IFS= read -r dev; do
        [[ -n ${dev} ]] || continue
        if ! grep -Fqx -- "${dev}" "${current_file}" 2>/dev/null; then
            "${lifecycle}" cleanup-device "${dev}" || true
            log "Interface unavailable: ${dev}; cleanup done"
            readiness_changed=1
        fi
    done < "${active_file}"

    mv -f -- "${current_file}" "${active_file}"

    if ((readiness_changed == 1)); then
        reconcile_endpoint_underlay || log 'Endpoint underlay reconcile after VPN transition failed; previous policy kept where possible.'
        if ((readiness_became_ready == 1)); then
            refresh_leshy_after_vpn_ready
        fi
        flush_dns_caches
    fi

    iterations=$((iterations + 1))
    if ((max_iterations > 0 && iterations >= max_iterations)); then
        break
    fi

    sleep "${interval_seconds}"
done
